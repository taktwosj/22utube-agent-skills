{
  "schema_version": "politics_documentary_visual_profile_v1",
  "profile_id": "politics_documentary_broadcast_v4",
  "extends_profile_id": "politics_documentary_broadcast_v3",
  "default_profile": false,
  "activation": {
    "mode": "explicit_user_opt_in",
    "rollback_profile_id": "politics_documentary_broadcast_v3",
    "rollback_requires_rebuild_only": true
  },
  "render": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "safe_margin_px": 72
  },
  "layout": {
    "chapter_transition": {
      "background": "politics_or_city_image",
      "title_color": "#F4F8FB",
      "keyword_color": "#25E6D3",
      "connected_chapter_boxes": true
    },
    "body": {
      "left_chapter_rail": "fixed",
      "right_semantic_stage": "srt_driven",
      "chapter_rail_width_px": 430
    }
  },
  "chapter_states": {
    "current": {
      "accent": "#25E6D3",
      "scale": 1.06,
      "glow": true,
      "border_lit": true
    },
    "complete": {
      "accent": "#5F7D80",
      "opacity": 0.68,
      "marker": "complete"
    },
    "waiting": {
      "accent": "#263843",
      "opacity": 0.55,
      "marker": "waiting"
    }
  },
  "semantic_colors": {
    "verified_fact": {
      "color": "#25E6D3",
      "required_marker": null
    },
    "allegation_unverified": {
      "color": "#FF9F43",
      "required_marker": [
        "의혹",
        "미확인"
      ]
    },
    "rebuttal_conflict_risk": {
      "color": "#FF5E4D",
      "required_marker": null
    },
    "conclusion_alternative": {
      "color": [
        "#25E6D3",
        "#43D17B"
      ],
      "required_marker": null
    }
  },
  "semantic_response": {
    "required_fields": [
      "start_ms",
      "end_ms",
      "semantic_role",
      "active_state"
    ],
    "sync_tolerance_ms": 150,
    "active_scale": 1.06,
    "inactive_opacity_min": 0.4,
    "inactive_opacity_max": 0.55,
    "border_glow": true,
    "icon_pulse_count": 1,
    "connector_progress": true,
    "show_all_at_start": false,
    "hold_last_only": false
  },
  "focus_lines": {
    "format": [
      "svg",
      "canvas",
      "transparent_png"
    ],
    "opaque_background_forbidden": true,
    "enter_ms": 200,
    "visible_fade_min_ms": 600,
    "visible_fade_max_ms": 1200,
    "key_scenes_only": true,
    "protected_regions": [
      "face",
      "caption",
      "source_label"
    ]
  },
  "audio": {
    "voice_roles": [
      "TTS",
      "SOURCE_SPEECH"
    ],
    "normalization": "ffmpeg_loudnorm_2pass",
    "integrated_lufs": -14.0,
    "true_peak_dbtp_max": -1.0,
    "lra_max": 11.0,
    "clip_lufs_tolerance": 0.5,
    "final_lufs_tolerance": 0.5,
    "max_abs_gain_db": 18.0,
    "final_encode_headroom_db": -0.2,
    "bgm_normalize_to_voice_target": false,
    "sfx_normalize_to_voice_target": false,
    "mix_order": [
      "normalize_voice_clips",
      "assemble_voice_bus",
      "duck_bgm",
      "mix_sfx",
      "measure_final_master"
    ],
    "outlier_status": "FAIL_AUDIO_GAIN_OUTLIER"
  },
  "forbidden": [
    "person_or_party_color_assignment",
    "gold_positive_highlight_for_allegation",
    "all_right_elements_visible_at_scene_start",
    "last_right_element_active_for_entire_scene",
    "normalize_bgm_or_sfx_individually_to_minus_14_lufs",
    "static_file_existence_only_gate"
  ],
  "required_gates": [
    "PASS_CHAPTER_ACTIVE_STATE",
    "PASS_SEMANTIC_VISUAL_SYNC",
    "PASS_SOURCE_VIDEO_FOCUS_LINES",
    "PASS_AUDIO_LOUDNESS_NORMALIZATION"
  ]
}
