{
  "schema_version": 2,
  "profile_id": "politics_documentary_broadcast_v3",
  "locked_by_default": true,
  "override": "LATEST_EXPLICIT_USER_INSTRUCTION_ONLY",
  "scope": "EPISODE_VISUAL_LAYER_ONLY",
  "palette": {
    "background": "#071426",
    "panel": "#0D2038",
    "text_primary": "#F3F6FA",
    "text_secondary": "#9EB0C4",
    "accent_cyan": "#21C7D9",
    "accent_mustard": "#F4C542"
  },
  "layout": {
    "canvas": "16:9",
    "chapter_navigation_percent": [25, 27],
    "content_percent": [73, 75],
    "grid_columns": 12,
    "chapter_number_background_opacity_percent": [5, 8],
    "header": {
      "left": "CHAPTER_NUMBER",
      "center": "CHAPTER_TITLE",
      "right": "COMMENT_CTA"
    },
    "chapter_label_scale": 1.7,
    "chapter_title_scale": [1.35, 1.5],
    "chapter_list_bullets": false
  },
  "source": {
    "position": "LEFT_TOP",
    "label": "ACTUAL_YOUTUBE_CHANNEL_NAME",
    "date": "UPLOAD_DATE",
    "internal_source_id_visible": false
  },
  "visual_reference_manifest": "assets/political-documentary-reference-frames.json",
  "comment_cta": {
    "header_position": "RIGHT_TOP",
    "line_1": "댓글로 의견 부탁드립니다.",
    "line_2": "구독과 좋아요 부탁드립니다.",
    "show_on_chapter_frames": true,
    "bottom_right_visible": false,
    "final_end_card": true
  },
  "narration_visual_system": {
    "reference": "references/narration-visual-grammar.md",
    "templates": [
      "FLOW_NODES",
      "TIMELINE_PATH",
      "CORE_ORBIT",
      "COMPARE_SPLIT",
      "STEP_PROGRESS",
      "QUOTE_SPOTLIGHT"
    ],
    "fallback_template": null,
    "minimum_unique_templates_for_six_chapters": 4,
    "maximum_templates_per_chapter": 2,
    "maximum_major_shapes_per_screen": 5,
    "maximum_consecutive_same_template": 1,
    "sync_authority": "FINAL_SRT",
    "source_video_overlay_diagrams": false,
    "external_image_generation_default": false,
    "person_cutout_policy": "USER_APPROVED_REFERENCE_OR_EXISTING_ASSET"
  },
  "approved_screen_types": [
    "SOURCE_QUOTE_HERO",
    "NARRATION_SUMMARY_SPLIT",
    "NARRATION_PROCESS_CIRCLES",
    "CTA_END_CARD"
  ],
  "motion": {
    "background_fade_seconds": 0.3,
    "title_rise_pixels": [12, 20],
    "choice_stagger_seconds": [0.08, 0.12],
    "selection_pulse_count": 1
  },
  "forbidden": [
    "GAME_HUD",
    "CYBERPUNK",
    "NEON_UI",
    "BRUSH_FONT",
    "THICK_TEXT_STROKE",
    "REPEATED_BLINK",
    "EXCESSIVE_DIAGONAL_DECORATION"
  ],
  "thumbnail_handoff": {
    "recommended_image_people_count": 3,
    "same_person_allowed": true,
    "hook_word_count": 3,
    "main_copy_count": 1,
    "support_copy_max_lines": 2,
    "field_order": [
      "추천 이미지 인물 3명",
      "후킹 단어 3개",
      "메인 문구 1",
      "보조 문구 2",
      "디자인"
    ]
  }
}
