{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "politics_term_review.schema.json",
  "title": "Politics term review decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewed_by",
    "reviewed_at",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": "politics_term_review_v1"
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "term_id",
          "canonical",
          "action",
          "evidence"
        ],
        "properties": {
          "term_id": {
            "type": "string",
            "pattern": "^pt_[0-9a-f]{16}$"
          },
          "canonical": {
            "type": "string",
            "minLength": 2
          },
          "action": {
            "enum": [
              "approve",
              "keep_observed",
              "deprecate",
              "block"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "asr_confusions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "surface",
                "evidence"
              ],
              "properties": {
                "surface": {
                  "type": "string",
                  "minLength": 2
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
