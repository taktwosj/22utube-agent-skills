{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "politics-longform-script-lock.v1",
  "title": "110 정치롱폼 대본 잠금",
  "description": "110이 생성하고 111이 소비하는 단일 대본 잠금 계약. JSON Schema는 모양을 설명하고 실제 경로·SHA·증거 결합은 각 게이트가 검사한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "episode_id", "status", "lock_version", "locked_at",
    "produced_by", "script_sha256", "locked_script", "evidence",
    "events", "authority", "next_stage"
  ],
  "properties": {
    "schema": {"const": "politics-longform-script-lock.v1"},
    "episode_id": {
      "type": "string",
      "pattern": "^PL_[0-9]{8}_[a-z0-9_]+$"
    },
    "status": {"const": "SCRIPT_LOCKED"},
    "lock_version": {"type": "integer", "minimum": 1},
    "locked_at": {"type": "string", "format": "date-time"},
    "produced_by": {"const": "110-politics-longform-script"},
    "script_sha256": {"$ref": "#/$defs/sha256"},
    "locked_script": {"$ref": "#/$defs/relPath"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_script", "source_packet", "source_srt_review", "verification_report",
        "independent_review", "user_approval"
      ],
      "properties": {
        "approved_script": {"$ref": "#/$defs/lockedInput"},
        "source_packet": {"$ref": "#/$defs/lockedInput"},
        "source_srt_review": {"$ref": "#/$defs/lockedInput"},
        "verification_report": {"$ref": "#/$defs/lockedInput"},
        "independent_review": {"$ref": "#/$defs/lockedInput"},
        "user_approval": {"$ref": "#/$defs/lockedInput"}
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_event_id", "claude_review_event_id",
        "user_approval_event_id"
      ],
      "properties": {
        "review_event_id": {"type": "string", "minLength": 1},
        "claude_review_event_id": {"type": "string", "minLength": 1},
        "user_approval_event_id": {"type": "string", "minLength": 1}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drafter", "reviewer", "final_lock"],
      "properties": {
        "drafter": {"const": "PROJECT_GPT"},
        "reviewer": {"enum": ["CLAUDE", "CODEX_CLI"]},
        "final_lock": {"const": "USER"}
      }
    },
    "next_stage": {"const": "111-politics-longform-voice-srt"}
  },
  "$defs": {
    "relPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$)).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lockedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relPath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
