{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "11short segment_decision_table",
  "type": "object",
  "required": ["segments"],
  "properties": {
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "segment_id",
          "start",
          "end",
          "scene_ids",
          "visual_summary_ko",
          "whisper_text",
          "voice_present",
          "ocr_texts",
          "audio_type",
          "segment_type",
          "story_function",
          "audio_action",
          "text_action",
          "capcut_text_layer",
          "capcut_audio_layer",
          "decision_reason",
          "evidence_refs",
          "uncertainty"
        ],
        "properties": {
          "segment_id": { "type": "string" },
          "start": { "type": ["number", "string"] },
          "end": { "type": ["number", "string"] },
          "scene_ids": { "type": "array" },
          "ocr_texts": { "type": "array" },
          "evidence_refs": { "type": "array" }
        }
      }
    }
  }
}
