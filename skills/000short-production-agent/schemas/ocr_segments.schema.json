{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "11short ocr_segments",
  "type": "object",
  "required": ["ocr_status", "ocr_engine_primary", "ocr_engine_used", "segments"],
  "properties": {
    "ocr_status": { "enum": ["RAN_WITH_RESULT", "RAN_EMPTY", "NO_ONSCREEN_TEXT", "FAILED", "NOT_RUN"] },
    "ocr_engine_primary": { "type": "string" },
    "ocr_engine_used": { "type": "string" },
    "engine_fallback": { "type": "boolean" },
    "fallback_reason": { "type": "string" },
    "segments": { "type": "array" }
  }
}
