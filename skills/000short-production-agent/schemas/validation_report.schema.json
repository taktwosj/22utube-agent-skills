{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "11short validation_report",
  "type": "object",
  "required": [
    "source_acquisition",
    "evidence_extraction",
    "crosscheck",
    "segment_decision",
    "capcut_layout",
    "final_gate"
  ],
  "properties": {
    "source_acquisition": { "type": "object" },
    "evidence_extraction": {
      "type": "object",
      "required": ["scenedetect_status", "stt_status", "ocr_status", "ocr_engine_recorded", "audio_vad_status"],
      "properties": {
        "scenedetect_status": { "enum": ["PASS", "FAIL"] },
        "stt_status": { "enum": ["RAN_WITH_RESULT", "RAN_EMPTY", "AUDIO_ABSENT", "FAILED", "NOT_RUN"] },
        "ocr_status": { "enum": ["RAN_WITH_RESULT", "RAN_EMPTY", "NO_ONSCREEN_TEXT", "FAILED", "NOT_RUN"] },
        "ocr_engine_recorded": { "enum": ["PASS", "FAIL"] },
        "audio_vad_status": { "enum": ["PASS", "FAIL"] }
      }
    },
    "crosscheck": { "type": "object" },
    "segment_decision": { "type": "object" },
    "capcut_layout": { "type": "object" },
    "final_gate": {
      "type": "object",
      "required": ["overall_status", "SCRIPT_LOCK", "upload_ready"],
      "properties": {
        "overall_status": { "enum": ["PASS", "FAILED", "BLOCKED", "INCOMPLETE"] },
        "SCRIPT_LOCK": { "enum": ["YES", "NO"] },
        "upload_ready": { "enum": ["YES", "NO"] }
      }
    }
  }
}
