{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "11short target_phrase_check",
  "type": "object",
  "required": ["target_phrases", "detected", "missing", "decision"],
  "properties": {
    "target_phrases": { "type": "array", "items": { "type": "string" } },
    "detected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phrase", "found", "start", "end", "matched_text", "source", "confidence"],
        "properties": {
          "phrase": { "type": "string" },
          "found": { "type": "boolean" },
          "start": { "type": ["string", "number"] },
          "end": { "type": ["string", "number"] },
          "matched_text": { "type": "string" },
          "speaker": { "type": "string" },
          "source": { "type": "string" },
          "confidence": { "type": ["number", "string"] },
          "is_verified_source_speech": { "type": "boolean" }
        }
      }
    },
    "missing": { "type": "array" },
    "decision": { "enum": ["verified", "partial", "not_found", "not_required"] }
  }
}
