{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "11short evidence_pack",
  "type": "object",
  "required": ["claims_to_evidence"],
  "properties": {
    "claims_to_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "evidence", "status"],
        "properties": {
          "claim": { "type": "string" },
          "evidence": { "type": "string" },
          "status": { "enum": ["PASS", "FAIL", "WARN", "NOT_REQUIRED"] }
        }
      }
    }
  }
}
