{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tikitaka block_role_map",
  "type": "object",
  "required": ["roles"],
  "properties": {
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["edit_id", "caption_type"],
        "properties": {
          "edit_id": { "type": "string", "minLength": 1 },
          "caption_type": {
            "enum": [
              "speaker_quote",
              "tts_narration",
              "situation_caption",
              "tts_plus_source",
              "ranking_item"
            ]
          }
        }
      }
    }
  }
}
