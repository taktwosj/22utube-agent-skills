{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shorts Source Identity Lock",
  "type": "object",
  "required": [
    "status",
    "canonical_url",
    "video_id",
    "local_source_path",
    "sha256",
    "duration_sec"
  ],
  "properties": {
    "status": {"const": "PASS"},
    "canonical_url": {"type": "string", "minLength": 1},
    "video_id": {"type": "string", "minLength": 1},
    "local_source_path": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "duration_sec": {"type": "number", "exclusiveMinimum": 0}
  },
  "additionalProperties": true
}
