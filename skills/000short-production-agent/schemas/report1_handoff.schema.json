    "gate_name",
    "owner_skill",
    "next_skill",
    "required_before_next",
    "report1_approved",
    "voice_audio_route_decided"
  ],
  "properties": {
    "gate_name": { "const": "REPORT1_HANDOFF_GATE" },
    "owner_skill": { "const": "00-tikitaka" },
    "next_skill": { "const": "000short-production-agent" },
    "next_gate": { "const": "CAPCUT_OPENABLE_PROJECT" },
    "report1_approved": { "type": "boolean" },
    "voice_audio_route_decided": { "type": "boolean" },
    "stage2_default_base": { "const": "shrt white" },
    "required_before_next": {
      "type": "array",
      "contains": { "const": "report1_approved=true" }
    }
  }
}
