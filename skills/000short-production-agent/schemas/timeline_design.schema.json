{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tikitaka v3 expanded timeline_design",
  "type": "object",
  "required": ["project_duration_sec", "source_fingerprint_sha256", "segments"],
  "properties": {
    "project_duration_sec": { "type": "number", "exclusiveMinimum": 0 },
    "source_fingerprint_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "edit_id",
          "source_ref",
          "source_order",
          "timeline_order",
          "assembly_role",
          "caption_type",
          "visible_text_role",
          "audio_role",
          "time_start",
          "time_end",
          "track",
          "duration_basis",
          "duration_status",
          "audio_policy",
          "visual_strategy"
        ],
        "properties": {
          "edit_id": { "type": "string", "minLength": 1 },
          "source_ref": { "type": "string", "minLength": 1 },
          "source_order": { "type": "integer", "minimum": 0 },
          "timeline_order": { "type": "integer", "minimum": 0 },
          "parallel_group_id": { "type": "string", "minLength": 1 },
          "assembly_role": {
            "type": "string",
            "enum": [
              "intro_narration",
              "context_narration",
              "payoff_narration",
              "ending_narration",
              "verified_speaker_quote",
              "situation_caption",
              "reaction_caption",
              "card_or_comment_caption",
              "source_visual_hold",
              "source_visual_action",
              "transition_or_separator",
              "ranking_item"
            ]
          },
          "caption_type": { "type": "string", "minLength": 1 },
          "visible_text_role": { "type": "string", "minLength": 1 },
          "audio_role": { "type": "string", "minLength": 1 },
          "time_start": { "type": "string", "minLength": 1 },
          "time_end": { "type": "string", "minLength": 1 },
          "track": {
            "type": "string",
            "not": { "enum": ["A9", "A10", "A11", "A12"] }
          },
          "duration_basis": {
            "type": "string",
            "enum": [
              "source_range",
              "estimated_tts_duration",
              "actual_tts_duration",
              "fixed_design_duration",
              "visual_hold"
            ]
          },
          "duration_status": {
            "type": "string",
            "enum": [
              "SOURCE_AUDIO_LOCKED",
              "ESTIMATED_ACCEPTED",
              "ACTUAL_AUDIO_LOCKED",
              "FIXED_DESIGN_LOCKED",
              "WAIT_ACTUAL_TTS_AUDIO"
            ]
          },
          "audio_policy": { "type": "string", "minLength": 1 },
          "visual_strategy": { "type": "string", "minLength": 1 },
          "tts_text_ref": { "type": "string", "minLength": 1 },
          "planned_tts_duration_sec": { "type": "number", "minimum": 0 },
          "tts_duration_status": {
            "type": "string",
            "enum": [
              "ESTIMATED_ACCEPTED",
              "ACTUAL_AUDIO_LOCKED",
              "WAIT_ACTUAL_TTS_AUDIO"
            ]
          },
          "estimated_tts_duration_sec": { "type": "number", "minimum": 0 },
          "actual_tts_duration_sec": { "type": "number", "minimum": 0 },
          "source_audio_range": { "type": ["object", "string"] },
          "quote_verification_status": { "type": "string", "minLength": 1 },
          "source_audio_ref": {
            "const": "10_analysis/audio/vocals.wav"
          },
          "source_audio_provenance": {
            "const": "demucs_full_source_vocals"
          }
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                { "properties": { "caption_type": { "const": "tts_narration" } } },
                { "properties": { "audio_role": { "const": "audio.narration_tts" } } }
              ]
            },
            "then": {
              "required": [
                "tts_text_ref",
                "planned_tts_duration_sec",
                "tts_duration_status"
              ]
            }
          },
          {
            "if": {
              "properties": { "tts_duration_status": { "const": "ESTIMATED_ACCEPTED" } },
              "required": ["tts_duration_status"]
            },
            "then": { "required": ["estimated_tts_duration_sec"] }
          },
          {
            "if": {
              "properties": { "tts_duration_status": { "const": "ACTUAL_AUDIO_LOCKED" } },
              "required": ["tts_duration_status"]
            },
            "then": { "required": ["actual_tts_duration_sec"] }
          },
          {
            "if": {
              "anyOf": [
                { "properties": { "caption_type": { "const": "speaker_quote" } } },
                { "properties": { "assembly_role": { "const": "verified_speaker_quote" } } }
              ]
            },
            "then": {
              "required": [
                "source_audio_range",
                "quote_verification_status",
                "source_audio_ref",
                "source_audio_provenance"
              ]
            }
          }
        ]
      }
    }
  }
}
