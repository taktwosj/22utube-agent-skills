{
  "schema_version": "001short-tools-v1",
  "capcut_root": "shrt white",
  "root_zip": "00_asset_tools/templates/capcut/shrt_white_base_v1/shrt_white_base_v1_CAPCUT_20260709_openfix.zip",
  "matrix": {"time_axis": "horizontal", "tool_axis": "vertical", "repeat": true, "coexist": true},
  "executable_protocol": {
    "file": "protocol.json",
    "schema": "schemas/executable_protocol.schema.json",
    "validator": "scripts/validate_executable_protocol.py",
    "self_check_command": "python3 scripts/validate_executable_protocol.py --self-check",
    "plan_command": "python3 scripts/validate_executable_protocol.py --plan {production_plan}",
    "completion_command": "python3 scripts/validate_executable_protocol.py --completion-report {completion_report}",
    "completion_report": "{episode_root}/90_reports/completion_report.json",
    "pass": "PASS",
    "fail": "STOP_PROTOCOL_GATE"
  },
  "session_handoff": {
    "schema": "schemas/conversation_handoff.schema.json",
    "validator": "scripts/validate_conversation_handoff.py",
    "template": "templates/conversation-handoff.json",
    "env_file": "$HOME/.hermes/.env",
    "env_load": "SOURCE_ONCE_WITHOUT_OUTPUT",
    "pass": "PASS",
    "fail": "HANDOFF_INVALID"
  },
  "analysis_tools": {
    "authority": "source.mp4",
    "inputs": ["user_brief_review", "gemini_analysis", "optional_comment_insights"],
    "methods": ["frame_inspection", "ocr", "audio_inspection"],
    "unresolved": "WAIT_OCR_UNRESOLVED",
    "comment_insights": {
      "optional": true,
      "authority": "audience_interpretation_only",
      "api_key_handling": "local_app_hasApiKey_and_live_response_only; never_print_or_store_key",
      "probe_success": "ok=true, video_title_present, comment_error_absent",
      "fetch": "50_public_threads; relevance_and_time_samples; deduplicate",
      "rank_locally_by": ["like_count", "reply_count", "published_at"],
      "select": "five_to_six_meaningfully_different_reaction_clusters",
      "failure": "COMMENTS_UNAVAILABLE_NONBLOCKING"
    }
  },
  "source_vocal_separation": {
    "engine": "demucs",
    "preflight": "scripts/separate_source_vocals.py --preflight",
    "separator": "scripts/separate_source_vocals.py",
    "validator": "scripts/validate_vocal_stem.py",
    "when": "approved source speaker audio remains on A10",
    "output": "{episode_root}/30_audio_srt/source_vocals/vocals.wav",
    "capcut_role": "A10",
    "A12": "BGM",
    "automatic_claim_limit": "human listen QC required before completion"
  },
  "production_engine": {
    "skill": ".",
    "stage": "05",
    "time_unit": "microseconds",
    "source_identity": {
      "file": "source_identity.json",
      "schema": "schemas/source_identity.schema.json",
      "schema_version": "source-identity-v1",
      "required": ["episode_id", "source_id", "source_fingerprint", "media_path", "media_sha256"]
    },
    "approved_timeline": {
      "file": "approved_timeline.json",
      "schema": "schemas/approved_timeline.schema.json",
      "schema_version": "approved-timeline-v1",
      "required": ["episode_id", "source_fingerprint", "segments"],
      "segment_required": ["segment_id", "timeline_order", "role", "start", "duration", "source_ref"]
    },
    "design_handoff": {
      "file": "design_handoff.json",
      "schema": "schemas/design_handoff.schema.json",
      "schema_version": "tikitaka-design-handoff-v1",
      "required": ["episode_id", "status", "source_identity_path", "source_identity_sha256", "timeline_path", "timeline_sha256", "source_fingerprint", "approved_timeline_order"]
    },
    "validator": "scripts/validate_design_lock.py",
    "pass": "FINAL_DESIGN_LOCKED"
  },
  "vmake": {
    "url": "https://vmake.ai/video-watermark-remover/upload",
    "input": "source.mp4",
    "output": "clean_source.mp4",
    "trigger": "SOURCE_OCR_VERIFIED_BACKGROUND_DOM",
    "role": "visual_only",
    "embedded_audio": "mute",
    "manifest": "clean_visual_manifest.json",
    "manifest_schema": "schemas/clean_visual_manifest.schema.json",
    "receipt": "clean_visual_receipt.json",
    "receipt_schema": "schemas/clean_visual_receipt.schema.json",
    "validator": "scripts/validate_clean_visual.py"
  },
  "capcut_preflight": {
    "build_manifest": "{episode_root}/50_capcut_project/build_manifest.json",
    "prebuild_validator": "scripts/validate_prebuild.py",
    "postbuild_validator": "scripts/validate_postbuild.py",
    "required_before_build": ["EDIT_LOCK_HELD", "CAPCUT_CLOSED", "FINAL_DESIGN_LOCKED", "AUDIO_CAPTION_VALIDATED", "ROOT_CONTRACT_VERIFIED", "MEDIA_NORMALIZED", "TRACK_MAPPING_VERIFIED"],
    "edit_lock": {
      "required_fields": ["episode_id", "lock_owner"],
      "conflict": "WAIT_EDIT_LOCK"
    },
    "root_contract": {
      "required_files": ["draft_content.json", "draft_meta_info.json", "Timelines/project.json", "Resources/media/transparent_center_white_1080x1920.png"],
      "forbidden_globs": ["*.bak", ".before_*", "before_*", "*_backup_*", "*_old.*", "*_copy.*", "helper_*", "temp_*", "*.partial"],
      "missing": "WAIT_CAPCUT_ROOT_CONTRACT"
    },
    "media": {
      "inspect": ["start_time", "duration", "time_base", "avg_frame_rate", "r_frame_rate", "rotation", "video_codec", "audio_codec", "sample_rate", "channel_layout"],
      "vfr_action": "WAIT_MEDIA_NORMALIZATION",
      "normalized_video": {"frame_rate": 30, "timestamp_start": 0, "new_sha256": true},
      "A9_A10_audio": {"container": "WAV", "codec": "PCM_S16LE", "sample_rate": 48000, "channels": 1}
    },
    "track_mapping": {
      "required": ["VIDEO", "T1", "T2", "A9", "A10", "STATE", "A11", "A12", "SCREEN"],
      "missing": "WAIT_CAPCUT_TRACK_MAPPING",
      "new_tracks": false
    },
    "id_policy": {
      "replacement_material_id": "NEW",
      "replacement_online_id": "REMOVE",
      "replacement_request_id": "REMOVE",
      "canonical_fixed_assets": "PRESERVE_UNCHANGED"
    },
    "builder": "scripts/build_episode_capcut.py",
    "build_inputs_validator": "scripts/validate_build_inputs.py",
    "static_validator": "scripts/validate_capcut_project.py"
  },
  "production_tools": [
    {"id": "VIDEO", "role": "VMake clean visual", "audio": "mute"},
    {"id": "T1", "role": "top title 1"},
    {"id": "T2", "role": "top title 2"},
    {"id": "A9", "role": "TTS and TTS caption"},
    {"id": "A10", "role": "speaker caption and original point audio"},
    {"id": "STATE", "role": "situation emotion status caption"},
    {"id": "A11", "role": "sound effects"},
    {"id": "A12", "role": "background music"},
    {"id": "SCREEN", "role": "approved screen treatment"}
  ],
  "policies": {"new_tracks": false, "new_tools": false, "external_review_auto": false}
}
