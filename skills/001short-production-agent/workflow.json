{
  "schema_version": "001short-production-workflow-v3",
  "owner_skill": "001short-production-agent",
  "lane": "general_shorts_production",
  "blueprint_reference": "references/blueprint_matrix.md",
  "analysis_authority": "original_source_only",
  "assembly_visual": "vmake_submit_after_source_identity_nonblocking_source_provisional_then_clean_swap",
  "common": [
    "protocol.json",
    "tools.json",
    "references/blueprint_matrix.md"
  ],
  "executable_protocol": {
    "path": "protocol.json",
    "schema": "schemas/executable_protocol.schema.json",
    "validator": "scripts/validate_executable_protocol.py",
    "load_before_mode_routing": true,
    "self_check_required": true,
    "conflict_error": "STOP_PROTOCOL_CONFLICT"
  },
  "session_bootstrap": {
    "trigger": "new_session_with_001_conversation_handoff_json",
    "env_file": "$HOME/.hermes/.env",
    "env_load": "SOURCE_ONCE_WITHOUT_OUTPUT",
    "schema": "schemas/conversation_handoff.schema.json",
    "validator": "scripts/validate_conversation_handoff.py",
    "safe_summary_only": true,
    "resume_requires_episode_id_and_explicit_request": true,
    "old_episode_access_without_resume": "FORBIDDEN"
  },
  "runtime": {
    "state_path": "{episode_root}/90_workflow/state.json",
    "paperclip_entry_path": "{episode_root}/90_workflow/paperclip_entry.json",
    "paperclip_entry_validator": "scripts/validate_paperclip_entry.py",
    "paperclip_entry_required_before_stage": "01",
    "paperclip_stage_ledger_path": "{episode_root}/90_workflow/paperclip_stage_ledger.json",
    "paperclip_stage_ledger_required_fields": [
      "stage",
      "attempt_kind",
      "stage_started_at",
      "stage_finished_at",
      "elapsed_seconds",
      "outcome",
      "first_failure_code",
      "recovery_elapsed_seconds",
      "next_action"
    ],
    "paperclip_stage_ledger_authority": "P0-verifier issue readback",
    "state_required": [
      "episode_id",
      "current_stage",
      "status"
    ],
    "completion_report_path": "{episode_root}/90_reports/completion_report.json",
    "upload_info_path": "{episode_root}/60_upload/upload_info.json",
    "work_outputs": {
      "01": "{episode_root}/10_analysis/source-analysis.md",
      "02": "{episode_root}/20_script/original-blueprint.md",
      "03": "{episode_root}/20_script/first-recommendation.md",
      "04": "{episode_root}/20_script/external-review.md",
      "05": "{episode_root}/20_script/final-blueprint.md",
      "06": "{episode_root}/40_assets_used/clean_visual_manifest.json",
      "07": "{episode_root}/30_audio_srt/audio_caption_lock.json",
      "08": "{episode_root}/50_capcut_project/static_validation.json",
      "09": "{episode_root}/60_exports/render_validation.json"
    },
    "update_state_after_pass_only": true
  },
  "completion_gate": {
    "report_path": "{episode_root}/90_reports/completion_report.json",
    "validator": "python3 scripts/validate_executable_protocol.py --completion-report {episode_root}/90_reports/completion_report.json",
    "validator_pass_required": true,
    "required_before_states": [
      "all_harness_pass",
      "WAIT_UPLOAD_APPROVAL",
      "upload_ready",
      "uploaded"
    ],
    "required_fields": [
      "episode_id",
      "capcut_project_name",
      "production_mode",
      "T1",
      "T2",
      "validation_status",
      "source_file_evidence",
      "vmake_final_download",
      "capcut_visual_confirmation",
      "completion_claim",
      "upload_title",
      "upload_description",
      "sources",
      "public_upload_status"
    ],
    "missing_error": "UPLOAD_METADATA_MISSING",
    "public_upload_approval_error": "PUBLIC_UPLOAD_NOT_APPROVED",
    "application_open_or_playback": "REQUIRED_BEFORE_COMPLETION",
    "vmake_final_download_evidence_required": true,
    "render_evidence_required_when_claiming": [
      "RENDER_COMPLETE",
      "UPLOAD_READY",
      "PUBLIC_UPLOAD_COMPLETE"
    ]
  },
  "parallel_execution": {
    "enabled": true,
    "mode": "evidence_only",
    "max_workers": 4,
    "reference": "references/parallel-execution.md",
    "coordinator": {
      "count": 1,
      "responsibilities": [
        "dispatch_workers",
        "verify_worker_evidence",
        "promote_approved_candidates",
        "run_canonical_validators",
        "advance_state_sequentially"
      ]
    },
    "canonical_writes": {
      "owner": "coordinator_only",
      "targets": [
        "runtime.state_path",
        "runtime.work_outputs",
        "canonical_manifests",
        "canonical_evidence",
        "active_capcut_draft"
      ],
      "state_advance": "barrier_pass_then_sequential_only"
    },
    "workers": {
      "result_mode": "evidence_only",
      "unique_root_required": true,
      "root_template": "{episode_root}/90_workflow/parallel/{run_id}/{worker_id}/{task_id}",
      "candidate_artifacts": "worker_root_only_until_coordinator_promotion",
      "live_transcripts": {
        "record_paths_when_available": true,
        "authority": "observation_only",
        "artifact_reverification_required": true,
        "parent_session_end_behavior": "do_not_treat_delegation_as_durable"
      },
      "forbidden_writes": [
        "runtime.state_path",
        "runtime.work_outputs",
        "canonical_manifests",
        "canonical_evidence",
        "active_capcut_draft"
      ]
    },
    "gui": {
      "owner_required": true,
      "max_owners": 1,
      "tools": [
        "vmake",
        "capcut"
      ],
      "mutual_exclusion": true,
      "remote_job_processing_does_not_hold_gui_owner": true,
      "handoff_requires_closed_gui": true,
      "computer_use_delivery_ladder": [
        "background",
        "coordinate_if_recommended",
        "foreground_if_recommended"
      ],
      "recapture_after_state_change": true,
      "foreground_requires_driver_recommendation": true
    },
    "barrier_policy": {
      "all_required_evidence_must_pass": true,
      "sha256_reverify": true,
      "episode_id_match": true,
      "failed_or_missing_evidence": "no_state_advance",
      "state_writer": "coordinator_only",
      "state_write_order": "sequential"
    },
    "fanout": {
      "after_source_identity_verified": {
        "trigger_status": "SOURCE_OCR_VERIFIED",
        "workers": 1,
        "lanes": [
          {
            "id": "vmake_submit",
            "gui": "vmake",
            "output": "vmake_submission_evidence"
          }
        ],
        "nonblocking_next_stages": [
          "02",
          "03",
          "04"
        ],
        "candidate_receipt": {
          "validator": "scripts/validate_clean_candidate.py",
          "status_meaning": "TECHNICAL_IDENTITY_ONLY",
          "quality_authority": "user"
        }
      },
      "stage01": {
        "workers": 3,
        "source_mode": "read_only",
        "lanes": [
          {
            "id": "source_probe",
            "output": "source_probe_evidence"
          },
          {
            "id": "full_ocr",
            "output": "ocr_evidence"
          },
          {
            "id": "scene_audio_inventory",
            "output": "scene_audio_inventory_evidence"
          }
        ],
        "barrier": {
          "required_evidence": [
            "source_probe_evidence",
            "ocr_evidence",
            "scene_audio_inventory_evidence"
          ],
          "coordinator_action": "write_source_analysis_then_validate"
        },
        "commit_status": "SOURCE_OCR_VERIFIED"
      },
      "stage03": {
        "workers": 4,
        "source_mode": "read_only_locked_inputs",
        "lanes": [
          {
            "id": "hook_options",
            "output": "hook_options_evidence"
          },
          {
            "id": "caption_structure",
            "output": "caption_structure_evidence"
          },
          {
            "id": "audio_sfx_plan",
            "output": "audio_sfx_plan_evidence"
          },
          {
            "id": "screen_composition",
            "output": "screen_composition_evidence"
          }
        ],
        "barrier": {
          "required_evidence": [
            "hook_options_evidence",
            "caption_structure_evidence",
            "audio_sfx_plan_evidence",
            "screen_composition_evidence"
          ],
          "coordinator_action": "write_first_recommendation_then_validate"
        },
        "commit_status": "FIRST_RECOMMENDATION_READY"
      },
      "after_final_design_locked": {
        "trigger_status": "FINAL_DESIGN_LOCKED",
        "workers": 3,
        "lanes": [
          {
            "id": "vmake_candidate_finalize",
            "gui": null,
            "output": "clean_visual_evidence"
          },
          {
            "id": "audio_prep",
            "gui": null,
            "output": "audio_prep_evidence"
          },
          {
            "id": "stage08_readonly_preflight",
            "gui": null,
            "output": "stage08_readonly_preflight_evidence"
          }
        ],
        "barrier": {
          "required_evidence": [
            "audio_prep_evidence",
            "stage08_readonly_preflight_evidence"
          ],
          "nonblocking_evidence": [
            "clean_visual_evidence"
          ],
          "coordinator_action": "advance_audio_and_source_provisional_build_without_clean_wait",
          "sequential_state_advance": [
            "AUDIO_CAPTION_VALIDATED"
          ]
        },
        "next_stage": "07_AND_08"
      },
      "stage08_postbuild": {
        "trigger": "CAPCUT_BUILD_CREATED_AND_CLOSED",
        "mode": "read_only_validation",
        "workers": 4,
        "immutable_snapshot_required": true,
        "lanes": [
          {
            "id": "identity_paths",
            "output": "identity_paths_evidence"
          },
          {
            "id": "structure_materials",
            "output": "structure_materials_evidence"
          },
          {
            "id": "timeline_text",
            "output": "timeline_text_evidence"
          },
          {
            "id": "media_duration",
            "output": "media_duration_evidence"
          }
        ],
        "barrier": {
          "required_evidence": [
            "identity_paths_evidence",
            "structure_materials_evidence",
            "timeline_text_evidence",
            "media_duration_evidence"
          ],
          "coordinator_validator": "scripts/validate_capcut_project.py"
        },
        "commit_status": "CAPCUT_STATIC_VALIDATED"
      }
    },
    "stage09": {
      "mode": "strict_serial",
      "max_workers": 1,
      "fanout": false,
      "state_writer": "coordinator_only",
      "sequence": [
        "WAIT_USER_CAPCUT_CHECK",
        "USER_VISUAL_CHECKED",
        "WAIT_CAPCUT_CLOSE_FOR_REVALIDATION",
        "CAPCUT_POST_OPEN_REVALIDATED",
        "USER_APPROVED",
        "RENDER_VALIDATED",
        "WAIT_UPLOAD_APPROVAL"
      ],
      "router_args": [
        "--stage09-review-evidence",
        "--stage09-review-sha256",
        "--approved-evidence-root",
        "--capcut-evidence",
        "--capcut-sha256",
        "--render",
        "--render-sha256",
        "--evidence"
      ]
    }
  },
  "production_stages": [
    {
      "id": "01",
      "file": "steps/01-input-ocr.md",
      "pass": "SOURCE_OCR_VERIFIED"
    },
    {
      "id": "02",
      "file": "steps/02-original-blueprint.md",
      "pass": "ORIGINAL_BLUEPRINT_READY"
    },
    {
      "id": "03",
      "file": "steps/03-first-recommendation.md",
      "pass": "FIRST_RECOMMENDATION_READY"
    },
    {
      "id": "04",
      "file": "steps/04-external-review.md",
      "pass": "WAIT_USER_URAKKAI_APPROVAL",
      "required_evidence": [
        "20_script/external-review.md",
        "20_script/external-review.json"
      ]
    },
    {
      "id": "05",
      "file": "steps/05-final-blueprint.md",
      "pass": "FINAL_DESIGN_LOCKED",
      "checks": [
        "references/checks/design-lock.md"
      ]
    },
    {
      "id": "06",
      "file": "steps/06-vmake-clean.md",
      "pass": "CLEAN_VISUAL_READY",
      "checks": [
        "references/checks/clean-visual.md"
      ]
    },
    {
      "id": "07",
      "file": "steps/07-audio.md",
      "pass": "AUDIO_CAPTION_VALIDATED",
      "checks": [
        "references/checks/audio-caption.md"
      ]
    },
    {
      "id": "08",
      "file": "steps/08-capcut-assembly.md",
      "pass": "CAPCUT_STATIC_VALIDATED",
      "checks": [
        "references/checks/build-inputs.md",
        "references/checks/capcut-project.md"
      ]
    },
    {
      "id": "09",
      "file": "steps/09-user-review-render.md",
      "pass": "RENDER_VALIDATED",
      "required_evidence": [
        "USER_VISUAL_CHECKED",
        "CAPCUT_POST_OPEN_REVALIDATED",
        "USER_APPROVED"
      ],
      "checks": [
        "references/checks/render.md"
      ]
    }
  ],
  "blueprint_frontend": {
    "inputs": [
      "source.mp4",
      "user_brief_review",
      "gemini_analysis"
    ],
    "analysis_authority": "source.mp4",
    "comment_insights": {
      "stage": "01",
      "optional": true,
      "artifact": "{episode_root}/10_analysis/comment_insights.json",
      "live_api_probe_required_when_configured": true,
      "api_key_visibility": "forbidden",
      "live_success": ["ok=true", "video_title_present", "comment_error_absent"],
      "request": "50_public_threads_then_local_like_reply_recency_rank_and_diverse_5_to_6_selection",
      "use": "Stage_03_04_creative_hook_and_audience_interpretation_only",
      "not_authority_for": ["source_fact", "identity", "event_claim"],
      "failure": "COMMENTS_UNAVAILABLE_NONBLOCKING"
    },
    "ocr": {
      "coverage": "full_source_scene_and_text_changes",
      "on_unresolved": "WAIT_OCR_UNRESOLVED"
    },
    "outputs": [
      {
        "type": "ORIGINAL_RECONSTRUCTION",
        "rule": "blueprint_alone_recreates_benchmark"
      },
      {
        "type": "FIRST_RECOMMENDATION",
        "rule": "use_user_review_and_source_verified_gemini_only"
      }
    ],
    "matrix": {
      "horizontal": "time_ranges",
      "vertical": [
        "ORIGINAL_VIDEO",
        "T1",
        "T2",
        "TTS_A9",
        "SPEAKER_A10",
        "STATE_CAPTION",
        "A11_SFX",
        "A12_BGM",
        "SCREEN"
      ],
      "repeat": true,
      "coexist": true
    },
    "external_review": {
      "enabled_for": [
        "URAKKAI"
      ],
      "provider": "claude_cli",
      "model": "Claude Opus 5",
      "effort": "low",
      "loop_count": 1,
      "reviews_per_loop": 1,
      "creator_machine": "macmini",
      "approval_authority": "user",
      "fallback": "Codex CLI gpt-5.6-sol at low effort",
      "evidence": "20_script/external-review.json",
      "rubric": "references/mara-urakkai-review-rubric.md",
      "verdicts": [
        "PASS_CANDIDATE",
        "REVISE_REQUIRED",
        "WAIT_SOURCE_RECHECK",
        "REJECTED_MARA_INSUFFICIENT"
      ],
      "verdict_advances_episode": false,
      "audio_policies": [
        "TTS_ONLY_MUTE_SOURCE",
        "A10_RETAINED_SYNC"
      ]
    },
    "vmake": {
      "trigger": "SOURCE_OCR_VERIFIED",
      "url": "https://vmake.ai/video-watermark-remover/upload",
      "input": "source.mp4",
      "output": "clean_source.mp4",
      "role": "capcut_visual_only",
      "embedded_audio": "mute",
      "submission_evidence": "90_workflow/vmake_submission.json",
      "candidate_receipt": "90_workflow/clean_candidate_receipt.json",
      "final_receipt": "90_workflow/clean_visual_receipt.json",
      "technical_check_only": [
        "source_identity_sha256",
        "candidate_sha256_differs_from_source",
        "ffprobe_duration",
        "ffprobe_resolution",
        "video_stream"
      ],
      "visual_quality_authority": "user",
      "interim_capcut_threshold_remaining_minutes": 10,
      "verify": [
        "playback",
        "ffprobe_duration",
        "ffprobe_resolution",
        "video_stream"
      ]
    },
    "assembly": {
      "template": "shrt white",
      "new_tracks": false,
      "new_tools": false,
      "a10_authority": "source.mp4",
      "capcut_polish_profile": "001short-capcut-polish-v2",
      "capcut_polish_validator": "scripts/validate_capcut_polish_profile.py",
      "source_audio_separation": "vocal_retain_choice_2",
      "source_audio_during_a9": "mute",
      "audio_loudness_lufs": -14,
      "transition_each_join": "W Flash",
      "video_ai_hd_level": 3,
      "video_smart_adjust": [42, 47],
      "video_sharpen": 50,
      "video_clear": 50,
      "state_caption_meaningful_character_max": 8,
      "speaker_caption_lines": "dynamic_current_speaker_count"
    }
  },
  "interim_capcut": {
    "allowed_when": {
      "after_status": "FINAL_DESIGN_LOCKED",
      "clean_visual_evidence": "missing_or_pending",
      "vmake_status": ["PROCESSING", "UNAVAILABLE", "DOWNLOAD_PENDING", "USER_WILL_SUPPLY"]
    },
    "purpose": "continue_full_reviewable_source_video_project_without_waiting_for_vmake",
    "video_asset": "00_input/source.mp4",
    "video_volume": 0,
    "original_audio_anchor": "A10",
    "original_audio_volume": 1,
    "status": "SOURCE_VIDEO_PROVISIONAL",
    "does_not_advance": [
      "CLEAN_VISUAL_READY",
      "UPLOAD_READY",
      "PUBLIC_UPLOAD_COMPLETE"
    ],
    "allows": [
      "CAPCUT_BUILD",
      "CAPCUT_STATIC_VALIDATION",
      "SOURCE_PROVISIONAL_RENDER",
      "USER_REVIEW"
    ],
    "batch_nonblocking": true,
    "on_clean_arrival": "replace_existing_VIDEO_asset_only_keep_project_structure",
    "quality_authority": "user",
    "report_required": {
      "visual_asset_mode": "SOURCE_VIDEO_PROVISIONAL",
      "video_asset": "00_input/source.mp4",
      "paperclip_status": "IN_REVIEW",
      "next_action": "CLEAN_SOURCE_SWAP_NONBLOCKING"
    }
  },
  "validation": {
    "router": "scripts/validate_stage.py",
    "stage_source": "state.current_stage",
    "caller_stage_override": false,
    "checks": {
      "05": {
        "reference": "references/checks/design-lock.md",
        "validator": "scripts/validate_design_lock.py",
        "protocol_validator": "python3 scripts/validate_executable_protocol.py --plan {episode_root}/20_script/production_plan.json"
      },
      "06": {
        "reference": "references/checks/clean-visual.md",
        "validator": "scripts/validate_clean_visual.py"
      },
      "07": {
        "reference": "references/checks/audio-caption.md",
        "validator": "scripts/validate_audio_caption.py"
      },
      "08": {
        "references": [
          "references/checks/build-inputs.md",
          "references/checks/capcut-project.md"
        ],
        "validators": [
          "scripts/validate_prebuild.py",
          "scripts/validate_build_inputs.py",
          "scripts/validate_capcut_project.py",
          "scripts/validate_postbuild.py"
        ],
        "required_prerequisites": [
          "design_lock_evidence",
          "audio_lock",
          "caption_lock"
        ],
        "optional_prerequisites": [
          "clean_visual_evidence"
        ],
        "allowed_visual_asset_modes": [
          "CLEAN_VISUAL_READY",
          "SOURCE_VIDEO_PROVISIONAL"
        ]
      },
      "09": {
        "reference": "references/checks/render.md",
        "validator": "scripts/validate_render.py",
        "completion_validator": "python3 scripts/validate_executable_protocol.py --completion-report {episode_root}/90_reports/completion_report.json",
        "review_evidence_schema": "schemas/stage09_review_evidence.schema.json",
        "output_evidence_policy": "approved_root_safe_new_file_only"
      }
    }
  },
  "capcut_preflight": {
    "stage": "08",
    "contract": "tools.json#/capcut_preflight",
    "pass": "CAPCUT_PREFLIGHT_VALIDATED",
    "build_allowed_on_fail": false
  },
  "post_open_revalidation": {
    "stage": "09",
    "required_order": [
      "CAPCUT_BUILD_CREATED",
      "CAPCUT_STATIC_VALIDATED",
      "WAIT_USER_CAPCUT_CHECK",
      "USER_VISUAL_CHECKED",
      "WAIT_CAPCUT_CLOSE_FOR_REVALIDATION",
      "CAPCUT_POST_OPEN_REVALIDATED",
      "USER_APPROVED"
    ],
    "checks": [
      "project_id",
      "draft_id",
      "timeline_id",
      "media_paths",
      "duration",
      "material_references"
    ],
    "pass": "CAPCUT_POST_OPEN_REVALIDATED"
  },
  "error_routes": {
    "HANDOFF_AUTHORITY": [
      "DESIGN_LOCK_SCHEMA",
      "SOURCE_IDENTITY",
      "TIMELINE_SHA",
      "TIMELINE_ORDER"
    ],
    "SOURCE_WORKING_CONFLICT": [
      "SOURCE_WORKING",
      "SOURCE_PROJECT",
      "SOURCE_SHA",
      "SOURCE_WRITE"
    ],
    "ID_MIRROR_SYNC": [
      "ID_",
      "PROJECT_ID"
    ],
    "STRUCTURE_LOCK": [
      "TRACK_",
      "LAYER_",
      "SEGMENT_",
      "Z_ORDER",
      "TRANSFORM",
      "SCALE",
      "ROTATION",
      "CROP",
      "MASK",
      "OPACITY",
      "BLEND",
      "TEXT_STYLE",
      "EFFECT_",
      "ANIMATION_",
      "TRANSITION_",
      "EXTRA_MATERIAL_REF"
    ],
    "MATERIAL_INTEGRITY": [
      "MATERIAL_",
      "DUPLICATE_MATERIAL",
      "ORPHAN_MATERIAL",
      "REMOTE_MATERIAL",
      "STALE_MATERIAL",
      "UNUSED_MATERIAL",
      "MEDIA_STREAM_TYPE",
      "SOURCE_RANGE"
    ],
    "PROJECT_EVIDENCE": [
      "PROJECT_PATH",
      "REQUIRED_JSON",
      "STRUCTURE_SNAPSHOT",
      "BUILD_CONTRACT",
      "REQUIRED_ASSET",
      "MEDIA_DECODE",
      "CAPCUT_EVIDENCE_PATH"
    ],
    "TIMELINE_TEXT": [
      "TIMELINE_",
      "ACTUAL_TIME",
      "UNAUTHORIZED_",
      "DUPLICATE_SOURCE",
      "PARALLEL_PAIR_",
      "ROLE_",
      "FORBIDDEN_VISIBLE",
      "UNAPPROVED_VISIBLE",
      "SUBTITLE_"
    ],
    "DOWNSTREAM_EVIDENCE": [
      "CAPCUT_EVIDENCE",
      "RENDER_",
      "ACTUAL_UPLOAD"
    ]
  },
  "recovery_routes": {
    "WAIT_EDIT_LOCK": {
      "action": [
        "STOP",
        "IDENTIFY_ACTIVE_EDITOR",
        "RELEASE_OR_TRANSFER_LOCK"
      ],
