{
  "$schema": "schemas/executable_protocol.schema.json",
  "schema_version": "001short-executable-protocol-v1",
  "owner_skill": "001short-production-agent",
  "lane": "general_shorts_production",
  "grid_harness": {
    "validator": "scripts/validate_capcut_grids.py",
    "original_path": "20_script/original-capcut-grid.md",
    "urakkai_path": "20_script/urakkai-capcut-grid.md",
    "row_order": [
      "T1", "T2", "A9_TEXT", "A10_TEXT_YELLOW", "A10_TEXT_WHITE",
      "STATE_LASER", "STATE_GLITCH", "STATE_FLICKER", "SCREEN_WHITE",
      "SCREEN_EFFECT", "VIDEO", "A9", "A10", "A11", "A12_RESERVED_EMPTY"
    ],
    "empty_cell_error": "TABLE_EMPTY_CELL_FORBIDDEN",
    "unverified_cell_error": "TABLE_UNVERIFIED_CELL",
    "a12_value": "비움",
    "a9_text_max_lines": 2,
    "a9_text_max_chars_per_line": 15,
    "state_laser_max_lines": 2,
    "state_laser_max_chars_per_line": 15,
    "builder_preflight_before_writes": true,
    "chat_report_required_in_auto_mode": true,
    "final_report_requires": [
      "draft_readback_summary",
      "project_filename_code_block",
      "absolute_project_path_code_block"
    ],
    "locked_artifact_binding": [
      "build_manifest.urakkai.video_clips",
      "build_manifest.source_audio",
      "approved_timeline.segments",
      "state.approved_timeline_path_sha256",
      "state.build_manifest_path_sha256",
      "state.design_lock_evidence_path_sha256",
      "state.audio_lock_path_sha256",
      "audio_lock.role_files",
      "state.caption_lock_path_sha256",
      "caption_lock.cues"
    ],
    "semantic_validation_before_writes": true,
    "semantic_error_codes": [
      "TABLE_VIDEO_RANGE_MISMATCH",
      "TABLE_ROLE_ACTUAL_PRESENT_DECLARED_EMPTY",
      "TABLE_ROLE_DECLARED_POPULATED_ACTUAL_MISSING",
      "TABLE_TITLE_TEXT_MISMATCH",
      "TABLE_CAPTION_LOCK_ROLE_MISSING",
      "TABLE_CELL_TEXT_MISMATCH",
      "TABLE_CAPTION_TEXT_MISMATCH",
      "TABLE_AUDIO_LOCK_ROLE_MISSING",
      "CAPTION_LOCK_CUE_UNASSEMBLED",
      "TABLE_STATE_LOCK_MISSING",
      "TABLE_STATE_LOCK_PATH_MISMATCH",
      "TABLE_STATE_LOCK_SHA_MISMATCH",
      "TABLE_DESIGN_LOCK_INVALID",
      "TABLE_AUDIO_CAPTION_LOCK_INVALID"
    ]
  },
  "track_layout": "shrt_white_base_v2_15",
  "canonical_tracks": [
    "VIDEO", "SCREEN_EFFECT", "SCREEN_WHITE", "STATE_FLICKER", "STATE_GLITCH",
    "STATE_LASER", "A10_TEXT_WHITE", "A10_TEXT_YELLOW", "A9_TEXT", "T2", "T1",
    "A9", "A10", "A11", "A12_RESERVED_EMPTY"
  ],
  "visual_asset_modes": ["CLEAN_VISUAL_READY", "SOURCE_VIDEO_PROVISIONAL", "USER_APPROVED_NONMATCHING_CLEAN_SOURCE"],
  "stage07_outputs": ["audio_lock.json", "caption_lock.json", "final.srt", "caption_timing_evidence.json"],
  "a12_policy": "EMPTY",
  "manual_finalization": {
    "automation_terminal_state": "WAIT_USER_CAPCUT_CHECK",
    "clean_source_policy": {
      "primary": "AGENT_PRIMARY_CLEAN_SOURCE",
      "fallback": "USER_FALLBACK_CLEAN_SOURCE",
      "user_override": "USER_APPROVED_NONMATCHING_CLEAN_SOURCE",
      "user_override_requires": ["EXPLICIT_USER_APPROVAL", "FILE_SHA_BINDING"],
      "fallback_reasons": [
        "VMAKE_CURRENT_WORK_WINDOW_INCOMPLETE",
        "VMAKE_ACQUISITION_ISSUE",
        "VMAKE_VERIFICATION_ISSUE"
      ],
      "sequence": [
        "VMAKE_SUBMIT_FIRST",
        "SOURCE_VIDEO_PROVISIONAL_BUILD_NONBLOCKING",
        "VALIDATE_CLEAN_SOURCE_THEN_VIDEO_ONLY_SWAP_OR_REASSEMBLY"
      ]
    },
    "stage08_clean_swap_route": "scripts/build_episode_capcut.py --swap-provisional-video-only",
    "user_only_actions": [
      "capcut_visual_review_and_refinement",
      "render",
      "upload"
    ],
    "source_video_provisional_next_action": "CLEAN_SOURCE_SWAP_NONBLOCKING"
  },
  "authority": {
    "policy": "SKILL.md",
    "machine_contract": "protocol.json",
    "state_machine": "workflow.json",
    "episode_plan": "20_script/production_plan.json",
    "enforcement": "scripts/validate_executable_protocol.py",
    "conflict_rule": "STOP_PROTOCOL_CONFLICT"
  },
  "schemas": {
    "protocol": "schemas/executable_protocol.schema.json",
    "production_plan": "schemas/executable_production_plan.schema.json",
    "completion_report": "schemas/completion_report.schema.json",
    "session_handoff": "schemas/conversation_handoff.schema.json",
    "vocal_stem_manifest": "schemas/vocal_stem_manifest.schema.json",
    "source_intake_receipt": "schemas/source_intake_receipt.schema.json"
  },
  "activation": {
    "aliases": [
      "01쇼츠",
      "001쇼츠",
      "001short",
      "001short-production-agent",
      "원본 우라까이",
      "클린하고 캣컵",
      "클린 작업하고 그대로"
    ],
    "forbidden_skill_mixing": [
      "top5isu-shorts",
      "other_production_lane"
    ]
  },
  "session_handoff": {
    "schema_version": "001short-session-handoff-v1",
    "owner_skill": "001short-production-agent",
    "lane": "general_shorts_production",
    "schema": "schemas/conversation_handoff.schema.json",
    "validator": "scripts/validate_conversation_handoff.py",
    "template": "templates/conversation-handoff.json",
    "env_file": "$HOME/.hermes/.env",
    "env_load": "SOURCE_ONCE_WITHOUT_OUTPUT",
    "resume_requires_episode_id_and_explicit_request": true,
    "old_episode_access_without_resume": "FORBIDDEN",
    "secret_material": "FORBIDDEN"
  },
  "production_modes": {
    "URAKKAI": {
      "trigger": "operator requests urakkai, rearrangement, structural re-edit, or equivalent",
      "source_order_unchanged": false,
      "meaningful_reorder_required": true,
      "minimum_video_segments": 2,
      "video_audio_mapping_must_match": true,
      "requires_original_blueprint": true,
      "requires_human_approval": true,
      "unchanged_error": "URAKKAI_STRUCTURE_UNCHANGED",
      "fake_split_forbidden": true,
      "approved_final_order_required": true,
      "allowed_audio_policies": [
        "A10_REASSEMBLED_SYNC",
        "TTS_ONLY_MUTE_SOURCE",
        "A9_TTS_PLUS_A10_REASSEMBLED"
      ]
    },
    "SOURCE_ORDER_UNCHANGED_CLEAN_ONLY": {
      "trigger": "operator explicitly requests clean-only, source-order unchanged, title-only, or equivalent",
      "source_order_unchanged": true,
      "speed_unchanged": true,
      "video_segments": 1,
      "original_audio_segments": 1,
      "video_volume": 0,
      "original_audio_volume": 1,
      "required_title_tracks": [
        "T1",
        "T2"
      ],
      "must_clear_tracks": [
        "STATE",
        "A10_TEXT",
        "A9_TEXT",
        "A9",
        "A11",
        "A12"
      ],
      "skip_fake_urakkai_gate": true,
      "explicit_exception_to_multi_cut_gate": true,
      "video_duration": "FULL_LENGTH",
      "original_audio_duration": "FULL_LENGTH",
      "source_order_change": "FORBIDDEN"
    },
    "SOURCE_ORDER_UNCHANGED_A10_RETAINED": {
      "trigger": "operator explicitly selects a full Demucs vocal stem without source reordering",
      "source_order_unchanged": true,
      "video_audio_mapping_must_match": true,
      "video_duration": "FULL_LENGTH",
      "a10_duration": "FULL_LENGTH",
      "allowed_audio_policies": ["A10_RETAINED_SYNC"],
      "source_order_change": "FORBIDDEN"
    }
  },
  "urakkai_approval": {
    "enabled_for": [
      "URAKKAI"
    ],
    "external_review_required": false,
    "approval_authority": "user",
    "auto_mode_skips_user_approval": true,
    "required_report_artifacts": [
      "20_script/original-capcut-grid.md",
      "20_script/urakkai-capcut-grid.md",
      "20_script/URAKKAI_BLUEPRINT.md"
    ],
    "manual_pass_state": "WAIT_USER_URAKKAI_APPROVAL",
    "auto_pass_state": "URAKKAI_AUTO_APPROVED"
  },
  "invariants": {
    "single_active_lane": true,
    "session_handoff_secret_material_forbidden": true,
    "session_handoff_owner_must_remain_001": true,
    "old_episode_access_requires_explicit_resume": true,
    "source_is_read_only": true,
    "state_advance_after_validator_pass_only": true,
    "gui_owner_count": 1,
    "paperclip_disabled": true,
    "vmake_dom_first": true,
    "vmake_submit_after_source_identity": true,
    "vmake_candidate_integrity_only": true,
    "vmake_visual_quality_authority_user": true,
    "vmake_nonblocking_source_provisional_allowed": true,
    "source_provisional_video_asset_key": "source_video",
    "source_provisional_report_required": true,
    "vmake_full_download_required": true,
    "vmake_direct_insert_required": true,
    "vmake_direct_insert_asset": "40_assets_used/clean_source.mp4",
    "vmake_direct_insert_asset_key": "clean_video",
    "user_approved_nonmatching_clean_source_allowed": true,
    "user_approved_nonmatching_clean_asset_key": "user_approved_clean_video",
    "urakkai_final_duration_independent_from_source": true,
    "clean_visual_duration_matches_source_before_edit": true,
    "clean_only_full_source_duration_required": true,
    "clean_visual_ffprobe_required": true,
    "clean_visual_contact_sheet_required": true,
    "capcut_root_immutable": true,
    "capcut_unique_staging_required": true,
    "capcut_project_media_internal": true,
    "capcut_promote_after_validation_only": true,
    "capcut_local_reopen_required": true,
    "capcut_post_open_normalization_required": true,
    "capcut_id_mirror_pass_required": true,
    "capcut_cloud_media_pass_required": true,
    "capcut_zip_test_required": true,
    "capcut_cloud_sync_explicit_request_required": true,
    "capcut_cloud_destination_explicit_request_required": true,
    "capcut_cloud_row_readback_required_when_requested": true,
    "capcut_cloud_reopen_playback_required_when_requested": true,
    "public_upload_requires_explicit_approval": true,
    "completion_report_requires_upload_metadata": true,
    "source_file_evidence_required": true,
    "vmake_final_download_evidence_required": true,
    "vmake_substitute_file_forbidden": true,
    "capcut_visual_confirmation_required_before_completion": true
    ,"capcut_polish_profile_required": true,
    "capcut_polish_profile_validator_required": true,
    "source_audio_vocal_stem_required_when_retained": true,
    "capcut_vocal_retain_metadata_not_audio_separation": true,
    "source_audio_mute_during_a9_required": true,
    "all_audio_loudness_normalized_lufs": -14,
    "video_join_transition_required": "W Flash",
    "video_ai_hd_level_required": 3,
    "state_caption_meaningful_character_max": 15,
    "speaker_caption_line_count": "dynamic_current_speaker_count"
  },
  "anchors": {
    "VIDEO": "verified clean visual, or explicitly reported source-video provisional; embedded audio muted when A10 is present",
    "T1": "top title line 1",
    "T2": "top title line 2",
    "A9": "TTS or narration",
    "A9_TEXT": "TTS-linked visible caption",
    "A10": "explicit mode-bound source clean audio, full Demucs stem, or mapped reassembled Demucs stem",
    "A10_TEXT": "original-speech caption",
    "STATE": "situation or state caption",
    "A11": "sound effects",
    "A12": "reserved empty",
    "SCREEN": "screen visual effect"
  },
  "stages": [
    {
      "id": "01",
      "name": "SOURCE_ANALYSIS",
      "requires": [
        "00_input/source.mp4",
        "00_input/source_metadata.json"
      ],
      "produces": [
        "10_analysis/source-analysis.md"
      ],
      "pass_state": "SOURCE_OCR_VERIFIED"
    },
    {
      "id": "02",
      "name": "ORIGINAL_BLUEPRINT",
      "requires_state": "SOURCE_OCR_VERIFIED",
      "produces": [
        "20_script/original-blueprint.md",
        "20_script/original-capcut-grid.md"
      ],
      "pass_state": "ORIGINAL_BLUEPRINT_READY"
    },
    {
      "id": "03",
      "name": "FIRST_RECOMMENDATION",
      "requires_state": "ORIGINAL_BLUEPRINT_READY",
      "produces": [
        "20_script/first-recommendation.md",
        "20_script/urakkai-capcut-grid.md"
      ],
      "pass_state": "FIRST_RECOMMENDATION_READY"
    },
    {
      "id": "04",
      "name": "URAKKAI_REPORT_AND_APPROVAL",
      "requires_state": "FIRST_RECOMMENDATION_READY",
      "produces": [
        "20_script/original-capcut-grid.md",
        "20_script/urakkai-capcut-grid.md",
        "20_script/URAKKAI_BLUEPRINT.md"
      ],
      "pass_state": "WAIT_USER_URAKKAI_APPROVAL_OR_URAKKAI_AUTO_APPROVED"
    },
    {
      "id": "05",
      "name": "FINAL_DESIGN",
      "requires_state": "USER_URAKKAI_APPROVED_OR_URAKKAI_AUTO_APPROVED",
      "produces": [
        "20_script/final-blueprint.md",
        "20_script/production_plan.json"
      ],
      "validators": [
        "scripts/validate_design_lock.py",
        "python3 scripts/validate_executable_protocol.py --plan {episode_root}/20_script/production_plan.json"
      ],
      "pass_state": "FINAL_DESIGN_LOCKED"
    },
    {
      "id": "06",
      "name": "VMAKE_CLEAN",
      "requires_state": "FINAL_DESIGN_LOCKED_OR_EXPLICIT_CLEAN_ONLY",
      "produces": [
        "40_assets_used/clean_source.mp4",
        "40_assets_used/clean_visual_manifest.json",
        "40_assets_used/vmake_final_download_evidence.json"
      ],
      "validators": [
        "scripts/validate_clean_visual.py"
      ],
      "pass_state": "CLEAN_VISUAL_READY"
    },
    {
      "id": "07",
      "name": "AUDIO_CAPTION_LOCK",
      "requires_state": "FINAL_DESIGN_LOCKED_OR_CLEAN_VISUAL_READY",
      "produces": [
        "30_audio_srt/audio_lock.json",
        "30_audio_srt/caption_lock.json",
        "30_audio_srt/final.srt",
        "30_audio_srt/caption_timing_evidence.json"
      ],
      "validators": [
        "scripts/validate_audio_caption.py"
      ],
      "pass_state": "AUDIO_CAPTION_VALIDATED"
    },
    {
      "id": "08",
      "name": "CAPCUT_BUILD",
      "requires_state": "AUDIO_CAPTION_VALIDATED_WITH_ACCEPTED_VISUAL_MODE",
      "produces": [
        "50_capcut_project/project.zip",
        "50_capcut_project/build_receipt.json"
      ],
      "validators": [
        "scripts/validate_build_inputs.py",
        "scripts/validate_capcut_project.py",
        "scripts/validate_capcut_cloud_media.py"
      ],
      "pass_state": "CAPCUT_STATIC_VALIDATED"
    },
    {
      "id": "09",
      "name": "USER_MANUAL_FINALIZATION",
      "requires_state": "CAPCUT_STATIC_VALIDATED",
      "produces": [],
      "pass_state": "WAIT_USER_CAPCUT_CHECK"
    }
  ],
  "completion_report": {
    "required_fields": [
      "episode_id",
      "capcut_project_name",
      "production_mode",
      "T1",
      "T2",
      "validation_status",
      "source_file_evidence",
      "vmake_final_download",
      "capcut_visual_confirmation",
      "completion_claim",
      "upload_title",
      "upload_description",
      "sources",
      "public_upload_status"
    ],
    "source_required_fields": [
      "channel",
      "url"
    ],
    "cloud_sync_row_required_fields": [
      "name",
      "size",
      "duration",
      "type",
      "modified_time"
    ],
    "public_upload_wait_values": [
      "WAIT_APPROVAL",
      "NOT_REQUESTED"
    ],
    "public_upload_done_values": [
      "UPLOADED",
      "PUBLISHED",
      "SCHEDULED"
    ],
    "public_upload_approval_field": "public_upload_approval",
    "capcut_cloud_sync": {
      "default_status": "NOT_REQUESTED",
      "requires_explicit_user_request": true,
      "destination_must_be_explicit": true,
      "forbid_preemptive_sync": true,
      "synced_status": "SYNCED"
    },
    "missing_error_prefix": "UPLOAD_METADATA_MISSING",
    "source_file_evidence_required_fields": [
      "local_path",
      "sha256",
      "duration",
      "approved_source_time_ranges"
    ],
    "vmake_final_download_required_fields": [
      "downloaded_file_path",
      "sha256",
      "size_bytes",
      "duration",
      "is_actual_vmake_final_download"
    ],
    "capcut_visual_confirmation_required_fields": [
      "actual_project_name",
      "screen_confirmation_status",
      "screen_evidence_path",
      "screen_evidence_sha256",
      "draft_readback",
      "final_project_hash"
    ],
    "render_claim_values": [
      "RENDER_COMPLETE",
      "UPLOAD_READY",
      "PUBLIC_UPLOAD_COMPLETE"
    ],
    "render_evidence_required_fields": [
      "mp4_path",
      "mp4_sha256",
      "size_bytes",
      "duration"
    ]
  },
  "errors": {
    "STOP_PROTOCOL_CONFLICT": "SKILL.md, protocol.json, and workflow.json conflict; do not guess",
    "TABLE_EMPTY_CELL_FORBIDDEN": "original or urakkai grid contains an implicit empty cell",
    "TABLE_UNVERIFIED_CELL": "original or urakkai grid contains an unverified cell",
    "TABLE_PLACEHOLDER_FORBIDDEN": "original or urakkai grid contains an explicit placeholder marker",
    "TABLE_PATH_OVERRIDE_FORBIDDEN": "builder grid paths must resolve only from the canonical episode root",
    "TABLE_VIDEO_RANGE_MISMATCH": "grid B/V ranges or source mapping do not match the locked build manifest",
    "TABLE_ROLE_ACTUAL_PRESENT_DECLARED_EMPTY": "grid declares a role empty although the locked assembly contains it",
    "TABLE_ROLE_DECLARED_POPULATED_ACTUAL_MISSING": "grid declares a populated role absent from the locked assembly",
    "TABLE_TITLE_TEXT_MISMATCH": "grid T1 or T2 text differs from the approved timeline",
    "TABLE_CAPTION_LOCK_ROLE_MISSING": "grid/timeline text role lacks a matching caption-lock cue",
    "TABLE_CELL_TEXT_MISMATCH": "grid cell text differs from the same-time approved timeline text",
    "TABLE_CAPTION_TEXT_MISMATCH": "caption-lock cue text or cue ID differs from the same-time timeline row",
    "TABLE_AUDIO_LOCK_ROLE_MISSING": "a populated A9 or A10 grid role is absent from audio_lock role_files",
    "TABLE_STATE_LOCK_MISSING": "state lacks a required artifact path or SHA lock",
    "TABLE_STATE_LOCK_PATH_MISMATCH": "state artifact path differs from the configured canonical locked path",
    "TABLE_STATE_LOCK_SHA_MISMATCH": "state artifact SHA lock does not match the current file",
    "TABLE_DESIGN_LOCK_INVALID": "source identity, design handoff, timeline, or design evidence binding is invalid",
    "TABLE_AUDIO_CAPTION_LOCK_INVALID": "the existing audio/caption validator rejects the state-bound locks",
    "TABLE_HEADER_INVALID": "grid time-axis header is missing, malformed, or out of order",
    "TABLE_ROW_MISSING": "grid is missing one or more required 15-track report rows",
    "TABLE_ROW_COUNT_INVALID": "grid must contain exactly the required 15 report rows",
    "TABLE_ROW_ORDER_INVALID": "grid rows do not match the fixed 15-track report order",
    "PRODUCTION_MODE_INVALID": "production mode is not declared",
    "URAKKAI_STRUCTURE_UNCHANGED": "urakkai final order equals original order",
    "CLEAN_ONLY_SOURCE_ORDER_CHANGED": "clean-only source and final order differ",
    "CLEAN_ONLY_VIDEO_COUNT": "clean-only requires exactly one VIDEO segment",
    "CLEAN_ONLY_AUDIO_COUNT": "clean-only requires exactly one A10 segment",
    "CLEAN_ONLY_VIDEO_RANGE": "clean-only VIDEO must cover the full source unchanged",
    "CLEAN_ONLY_AUDIO_RANGE": "clean-only A10 must cover the full source unchanged",
    "CLEAN_ONLY_VIDEO_VOLUME": "clean-only VIDEO volume must be zero",
    "CLEAN_ONLY_AUDIO_VOLUME": "clean-only A10 volume must be one",
    "CLEAN_ONLY_FORBIDDEN_TRACK_NOT_EMPTY": "clean-only forbidden track contains segments",
    "UPLOAD_METADATA_MISSING": "completion report lacks title, description, or sources",
    "CAPCUT_CLOUD_ROW_MISSING": "requested cloud sync lacks a verified cloud-row field",
    "CAPCUT_CLOUD_SYNC_EXPLICIT_REQUEST_REQUIRED": "cloud sync requires an explicit user request",
    "CAPCUT_CLOUD_SYNC_UNREQUESTED": "cloud sync evidence is forbidden without an explicit user request",
    "PUBLIC_UPLOAD_NOT_APPROVED": "public upload state requires explicit approval",
    "URAKKAI_FAKE_SPLIT": "urakkai uses contiguous fake splits without an effective structural reorder",
    "URAKKAI_AUDIO_VIDEO_MAPPING_MISMATCH": "used A10 source/target ranges do not exactly match VIDEO",
    "URAKKAI_AUDIO_POLICY_INVALID": "urakkai audio_policy is not declared by the protocol",
    "URAKKAI_TTS_ONLY_A10_FORBIDDEN": "TTS-only urakkai must leave A10 empty",
    "URAKKAI_TTS_ONLY_VIDEO_NOT_MUTED": "TTS-only urakkai must mute every VIDEO segment",
    "URAKKAI_TTS_ONLY_A9_REQUIRED": "TTS-only urakkai must contain at least one A9 segment",
    "URAKKAI_TTS_ONLY_FORBIDDEN_AUDIO_PRESENT": "TTS-only urakkai must leave A11 and A12 empty",
    "URAKKAI_TTS_ONLY_CLEAR_ANCHOR_MISSING": "TTS-only urakkai must declare cleared audio anchors",
    "VMAKE_DIRECT_INSERT_ASSET_INVALID": "VIDEO must use the canonical VMake clean_video asset",
    "PROTOCOL_URAKKAI_REVIEW_LOOP_COUNT": "urakkai review must complete exactly one current-local-runtime review before user approval",
    "SOURCE_FILE_EVIDENCE_MISSING": "completion report lacks verified source file evidence",
    "SOURCE_FILE_EVIDENCE_INVALID": "source file evidence does not match the actual file",
    "VMAKE_FINAL_DOWNLOAD_EVIDENCE_MISSING": "completion report lacks actual VMake final download evidence",
    "VMAKE_FINAL_DOWNLOAD_EVIDENCE_INVALID": "VMake download evidence does not match the actual downloaded file",
    "CAPCUT_VISUAL_CONFIRMATION_MISSING": "completion report lacks actual CapCut screen confirmation",
    "CAPCUT_VISUAL_CONFIRMATION_INVALID": "CapCut screen or draft readback evidence is invalid",
    "RENDER_EVIDENCE_MISSING": "render/upload claim lacks MP4 evidence",
    "RENDER_EVIDENCE_INVALID": "render MP4 evidence does not match the actual file"
  }
}
