{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "001short Stage09 review evidence",
  "type": "object",
  "required": [
    "schema_version", "episode_id", "capcut_project_evidence_path",
    "capcut_project_evidence_sha256", "events"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "001short-stage09-review-evidence-v1"},
    "episode_id": {"type": "string", "minLength": 1},
    "capcut_project_evidence_path": {"type": "string", "minLength": 1},
    "capcut_project_evidence_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "events": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "status", "episode_id", "capcut_project_evidence_sha256",
          "previous_event_sha256", "confirmed"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "USER_VISUAL_CHECKED",
              "CAPCUT_POST_OPEN_REVALIDATED",
              "USER_APPROVED"
            ]
          },
          "episode_id": {"type": "string", "minLength": 1},
          "capcut_project_evidence_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "previous_event_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "confirmed": {"type": "boolean", "const": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
