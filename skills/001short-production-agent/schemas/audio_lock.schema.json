{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "001short measured audio lock",
  "type": "object",
  "required": ["schema_version", "episode_id", "status", "audio_source", "audio_path", "audio_sha256", "measured_duration_us", "ffprobe_verified"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["001short-audio-lock-v1", "001short-audio-lock-v2", "001short-audio-lock-v3"]},
    "episode_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "const": "PASS"},
    "audio_source": {"type": "string", "enum": ["GENERATED_TTS", "SOURCE_CLIP", "SOURCE_VOCAL_STEM"]},
    "audio_path": {"type": "string", "minLength": 1},
    "audio_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "measured_duration_us": {"type": "integer"},
    "audio_codec": {"type": "string", "minLength": 1},
    "tts_evidence_path": {"type": "string", "minLength": 1},
    "tts_evidence_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "vocal_stem_manifest_path": {"type": "string", "minLength": 1},
    "vocal_stem_manifest_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "ffprobe_verified": {"type": "boolean", "const": true},
    "role_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "audio_path", "audio_sha256", "measured_duration_us", "audio_codec", "ffprobe_verified"],
        "properties": {
          "role": {"type": "string", "enum": ["A9", "A10", "A11", "A12"]},
          "audio_path": {"type": "string", "minLength": 1},
          "audio_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
          "measured_duration_us": {"type": "integer"},
          "audio_codec": {"type": "string", "minLength": 1},
          "ffprobe_verified": {"type": "boolean", "const": true}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
