{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "001short actual CAPCUT_PROJECT build contract",
  "type": "object",
  "required": [
    "schema_version", "episode_id", "source_project_path", "working_project_path", "evidence_root_path",
    "source_core_sha256", "source_root_sha256", "template_sha256", "design_lock_evidence_path",
    "design_lock_evidence_sha256", "structure_snapshot_sha256", "project_id", "draft_id",
    "audio_lock_path", "audio_lock_sha256", "caption_lock_path",
    "caption_lock_sha256", "final_srt_path", "final_srt_sha256",
    "approved_timeline_path", "approved_timeline_sha256", "build_inputs_receipt_path",
    "build_inputs_receipt_sha256",
    "main_timeline_id", "required_asset_paths", "approved_text", "approved_actual_order",
    "timeline", "primary_timeline_roles", "authorized_gaps", "authorized_overlaps", "parallel_pairs"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "001short-build-contract-v1"},
    "episode_id": {"type": "string", "minLength": 1},
    "source_project_path": {"type": "string", "minLength": 1},
    "working_project_path": {"type": "string", "minLength": 1},
    "evidence_root_path": {"type": "string", "minLength": 1},
    "source_core_sha256": {"type": "object"},
    "source_root_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "template_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "design_lock_evidence_path": {"type": "string", "minLength": 1},
    "design_lock_evidence_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "audio_lock_path": {"type": "string", "minLength": 1},
    "audio_lock_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "caption_lock_path": {"type": "string", "minLength": 1},
    "caption_lock_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "final_srt_path": {"type": "string", "minLength": 1},
    "final_srt_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "approved_timeline_path": {"type": "string", "minLength": 1},
    "approved_timeline_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "build_inputs_receipt_path": {"type": "string", "minLength": 1},
    "build_inputs_receipt_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "structure_snapshot_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "project_id": {"type": "string", "minLength": 1},
    "draft_id": {"type": "string", "minLength": 1},
    "main_timeline_id": {"type": "string", "minLength": 1},
    "required_asset_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "approved_text": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "approved_actual_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["segment_id", "role", "start", "duration", "end"],
        "properties": {
          "segment_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "start": {"type": "integer"},
          "duration": {"type": "integer"},
          "end": {"type": "integer"}
        },
        "additionalProperties": true
      }
    },
    "primary_timeline_roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "authorized_gaps": {"type": "array"},
    "authorized_overlaps": {"type": "array"},
    "parallel_pairs": {"type": "array"}
  },
  "additionalProperties": true
}
