{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "001short actual CAPCUT_PROJECT evidence",
  "type": "object",
  "required": [
    "schema_version", "status", "episode_id", "actual_project_path", "build_contract_path",
    "build_contract_sha256", "structure_snapshot_path", "structure_snapshot_sha256",
    "source_project_path", "source_core_sha256", "source_root_sha256", "template_sha256",
    "design_lock_evidence_path", "design_lock_evidence_sha256", "project_id", "draft_id", "main_timeline_id", "visual_asset_mode", "source_video_provisional",
    "timeline_json_files", "validated_files"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "001short-capcut-project-evidence-v1"},
    "status": {"type": "string", "const": "PASS"},
    "episode_id": {"type": "string", "minLength": 1},
    "actual_project_path": {"type": "string", "minLength": 1},
    "build_contract_path": {"type": "string", "minLength": 1},
    "build_contract_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "structure_snapshot_path": {"type": "string", "minLength": 1},
    "structure_snapshot_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "source_project_path": {"type": "string", "minLength": 1},
    "source_core_sha256": {"type": "object"},
    "source_root_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "template_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "design_lock_evidence_path": {"type": "string", "minLength": 1},
    "design_lock_evidence_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "project_id": {"type": "string", "minLength": 1},
    "draft_id": {"type": "string", "minLength": 1},
    "main_timeline_id": {"type": "string", "minLength": 1},
    "visual_asset_mode": {"enum": ["CLEAN_VISUAL_READY", "SOURCE_VIDEO_PROVISIONAL"]},
    "source_video_provisional": {"type": "boolean"},
    "timeline_json_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "validated_files": {"type": "object"}
  },
  "additionalProperties": false
}
