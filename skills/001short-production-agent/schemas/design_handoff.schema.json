{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "001short DESIGN_LOCK design handoff",
  "type": "object",
  "required": [
    "schema_version",
    "episode_id",
    "status",
    "source_identity_path",
    "source_identity_sha256",
    "timeline_path",
    "timeline_sha256",
    "source_fingerprint",
    "approved_timeline_order"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "tikitaka-design-handoff-v1"},
    "episode_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "const": "PASS"},
    "source_identity_path": {"type": "string", "minLength": 1},
    "source_identity_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "timeline_path": {"type": "string", "minLength": 1},
    "timeline_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "source_fingerprint": {"type": "string", "minLength": 1},
    "approved_timeline_order": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": true
}
