{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "001short protected CapCut structure snapshot",
  "type": "object",
  "required": ["schema_version", "authority", "track_order", "tracks"],
  "properties": {
    "schema_version": {"type": "string", "const": "001short-structure-snapshot-v1"},
    "authority": {
      "type": "object",
      "required": ["captured_from", "source_project_path", "source_root_sha256", "template_sha256", "design_lock_evidence_sha256"],
      "properties": {
        "captured_from": {"type": "string", "const": "source"},
        "source_project_path": {"type": "string", "minLength": 1},
        "source_root_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
        "template_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
        "design_lock_evidence_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"}
      },
      "additionalProperties": false
    },
    "track_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "tracks": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  },
  "additionalProperties": true
}
