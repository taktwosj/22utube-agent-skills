{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "001short original source evidence",
  "type": "object",
  "required": [
    "schema_version",
    "contract_version",
    "episode_id",
    "source_identity_path",
    "source_identity_sha256",
    "source_media_path",
    "source_media_sha256",
    "segments"
  ],
  "properties": {
    "schema_version": {"const": "001short-original-source-evidence-v1"},
    "contract_version": {"const": "001short-original-source-transcript-v1"},
    "episode_id": {"type": "string", "minLength": 1},
    "source_identity_path": {"type": "string", "minLength": 1},
    "source_identity_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "source_media_path": {"type": "string", "minLength": 1},
    "source_media_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "segment_id",
          "source_range_us",
          "keyframes",
          "transcript_evidence_path",
          "transcript_evidence_sha256",
          "audio_evidence_path",
          "audio_evidence_sha256",
          "classified_fields"
        ],
        "properties": {
          "segment_id": {"type": "string", "pattern": "^B[0-9]{2}$"},
          "source_range_us": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "integer", "minimum": 0}
          },
          "keyframes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "sha256", "timestamp_us", "literal_ocr"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
                "timestamp_us": {"type": "integer", "minimum": 0},
                "literal_ocr": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "transcript_evidence_path": {"type": "string", "minLength": 1},
          "transcript_evidence_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "audio_evidence_path": {"type": "string", "minLength": 1},
          "audio_evidence_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "classified_fields": {
            "type": "object",
            "required": [
              "situation_description",
              "speaker_statement",
              "narration",
              "tts_speaker_statement",
              "tts_narration"
            ],
            "properties": {
              "situation_description": {"type": "string", "minLength": 1},
              "speaker_statement": {"type": "string", "minLength": 1},
              "narration": {"type": "string", "minLength": 1},
              "tts_speaker_statement": {"const": "없음"},
              "tts_narration": {"const": "없음"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
