{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "001short reassembled Demucs stem manifest",
  "type": "object",
  "required": ["schema_version", "status", "episode_id", "full_stem_manifest_path", "full_stem_manifest_sha256", "reassembled_audio_path", "reassembled_audio_sha256", "target_duration_us", "mapping"],
  "properties": {
    "schema_version": {"enum": ["001short-reassembled-stem-manifest-v1", "001short-reassembled-stem-manifest-v2"]},
    "status": {"const": "PASS"},
    "episode_id": {"type": "string", "minLength": 1},
    "full_stem_manifest_path": {"type": "string", "minLength": 1},
    "full_stem_manifest_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "build_manifest_path": {"type": "string", "minLength": 1},
    "build_manifest_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "production_plan_path": {"type": "string", "minLength": 1},
    "production_plan_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "reassembled_audio_path": {"type": "string", "minLength": 1},
    "reassembled_audio_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "target_duration_us": {"type": "integer"},
    "mapping": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source_beat_id", "target_segment_id", "source_range_us", "target_range_us"], "additionalProperties": true}}
  },
  "allOf": [{
    "if": {"properties": {"schema_version": {"const": "001short-reassembled-stem-manifest-v2"}}},
    "then": {"required": ["build_manifest_path", "build_manifest_sha256", "production_plan_path", "production_plan_sha256"]}
  }],
  "additionalProperties": true
}
