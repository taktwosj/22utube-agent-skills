{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "001short clean candidate technical receipt",
  "type": "object",
  "required": [
    "schema_version", "status", "episode_id", "source_identity_path",
    "source_identity_sha256", "source_media_path", "source_media_sha256",
    "candidate_path", "candidate_sha256", "candidate_differs_from_source",
    "measured_duration_us", "width", "height", "video_stream_verified",
    "ffprobe_verified", "quality_evaluated", "user_visual_review_required",
    "final_clean_acceptance"
  ],
  "properties": {
    "schema_version": {"const": "001short-clean-candidate-receipt-v1"},
    "status": {"const": "PASS"},
    "episode_id": {"type": "string", "minLength": 1},
    "source_identity_path": {"type": "string", "minLength": 1},
    "source_identity_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "source_media_path": {"type": "string", "minLength": 1},
    "source_media_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "candidate_path": {"type": "string", "minLength": 1},
    "candidate_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "candidate_differs_from_source": {"const": true},
    "measured_duration_us": {"type": "integer", "minimum": 1},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "video_stream_verified": {"const": true},
    "ffprobe_verified": {"const": true},
    "quality_evaluated": {"const": false},
    "user_visual_review_required": {"const": true},
    "final_clean_acceptance": {"const": "NOT_DECIDED"}
  },
  "additionalProperties": false
}
