{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "001short TTS measurement evidence",
  "type": "object",
  "required": ["schema_version", "episode_id", "provider", "audio_sha256", "measured_duration_us", "ffprobe_verified"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["001short-tts-evidence-v1", "001short-tts-evidence-v2"]},
    "episode_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "audio_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "measured_duration_us": {"type": "integer"},
    "audio_codec": {"type": "string", "minLength": 1},
    "ffprobe_verified": {"type": "boolean", "const": true}
  },
  "additionalProperties": true
}
