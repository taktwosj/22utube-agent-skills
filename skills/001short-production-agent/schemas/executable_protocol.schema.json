{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taktwosj.example/schemas/001short-executable-protocol-v1.json",
  "title": "001short Executable Protocol",
  "type": "object",
  "required": [
    "schema_version",
    "owner_skill",
    "lane",
    "grid_harness",
    "execution_profiles",
    "original_beat_contract",
    "stage03_authoring",
    "capcut_root_clone_contract",
    "authority",
    "schemas",
    "session_handoff",
    "production_modes",
    "urakkai_approval",
    "invariants",
    "manual_finalization",
    "anchors",
    "stages",
    "completion_report",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "001short-executable-protocol-v1"
    },
    "owner_skill": {
      "const": "001short-production-agent"
    },
    "lane": {
      "const": "general_shorts_production"
    },
    "grid_harness": {
      "type": "object",
      "required": [
        "target_a9_text_scope",
        "target_a9_text_max_lines",
        "target_a9_text_max_chars_per_line",
        "original_a9_text_max_lines",
        "original_a9_text_max_chars_per_line",
        "state_laser_max_lines",
        "state_laser_max_chars_per_line"
      ],
      "properties": {
        "target_a9_text_scope": {"const": "new_urakkai_a9_tts_only"},
        "target_a9_text_max_lines": {"const": 2},
        "target_a9_text_max_chars_per_line": {"const": 10},
        "original_a9_text_max_lines": {"const": 2},
        "original_a9_text_max_chars_per_line": {"const": 15},
        "state_laser_max_lines": {"const": 2},
        "state_laser_max_chars_per_line": {"const": 15}
      },
      "additionalProperties": true
    },
    "execution_profiles": {
      "type": "object",
      "required": ["default", "profiles"],
      "properties": {
        "default": {"const": "NORMAL_FAST"},
        "profiles": {
          "type": "object",
          "required": ["NORMAL_FAST"],
          "additionalProperties": false,
          "properties": {
            "NORMAL_FAST": {
              "type": "object",
              "required": [
                "task_owner_count",
                "stage_sequence",
                "stage_execution",
                "state_writer",
                "worker_fanout",
                "evidence_only_worker_candidates",
                "coordinator_revalidation",
                "barrier_duplication",
                "validator_run",
                "validator_rerun"
              ],
              "properties": {
                "task_owner_count": {"const": 1},
                "stage_sequence": {"const": ["01", "02", "03", "04"]},
                "stage_execution": {"const": "single_task_owner_sequential"},
                "state_writer": {"const": "task_owner"},
                "worker_fanout": {"const": false},
                "evidence_only_worker_candidates": {"const": false},
                "coordinator_revalidation": {"const": false},
                "barrier_duplication": {"const": false},
                "validator_run": {"const": "once_per_current_artifact_revision"},
                "validator_rerun": {"const": "after_proven_relevant_change_only"}
              },
              "additionalProperties": false
            }
          }
        }
      },
      "additionalProperties": false
    },
    "original_beat_contract": {
      "type": "object",
      "required": ["id_pattern", "required_fields", "authority", "urakkai_substitution"],
      "properties": {
        "id_pattern": {"const": "Bxx"},
        "required_fields": {
          "const": [
            "situation_action",
            "lead_speaker",
            "delivery_mode",
            "narrative_function",
            "split_basis"
          ]
        },
        "authority": {"const": "source_observation_only"},
        "urakkai_substitution": {"const": "FORBIDDEN"}
      },
      "additionalProperties": false
    },
    "stage03_authoring": {
      "type": "object",
      "required": [
        "author_count",
        "author_role",
        "method",
        "subworkers",
        "requires_state",
        "locked_inputs",
        "original_grid_mutation"
      ],
      "properties": {
        "author_count": {"const": 1},
        "author_role": {"const": "task-owner"},
        "method": {"const": "independent_urakkai"},
        "subworkers": {"const": 0},
        "requires_state": {"const": "ORIGINAL_BLUEPRINT_READY"},
        "locked_inputs": {
          "const": [
            "20_script/original-blueprint.md",
            "20_script/original-capcut-grid.md"
          ]
        },
        "original_grid_mutation": {"const": "FORBIDDEN"}
      },
      "additionalProperties": false
    },
    "capcut_root_clone_contract": {
      "type": "object",
      "required": [
        "root_contract_validation_required",
        "root_zip_immutable",
        "extract_target",
        "source_authority_immutable",
        "assembly_target",
        "new_ids",
        "asset_injection_target",
        "assembled_clone_validation_required"
      ],
      "properties": {
        "root_contract_validation_required": {"const": true},
        "root_zip_immutable": {"const": true},
        "extract_target": {"const": "source_authority"},
        "source_authority_immutable": {"const": true},
        "assembly_target": {"const": "working_project_clone_only"},
        "new_ids": {"const": ["project_id", "draft_id", "timeline_id"]},
        "asset_injection_target": {"const": "working_project_clone_only"},
        "assembled_clone_validation_required": {"const": true}
      },
      "additionalProperties": false
    },
    "schemas": {
      "type": "object",
      "required": [
        "protocol",
        "production_plan",
        "completion_report",
        "session_handoff"
      ],
      "properties": {
        "protocol": {
          "const": "schemas/executable_protocol.schema.json"
        },
        "production_plan": {
          "const": "schemas/executable_production_plan.schema.json"
        },
        "completion_report": {
          "const": "schemas/completion_report.schema.json"
        },
        "session_handoff": {
          "const": "schemas/conversation_handoff.schema.json"
        },
        "source_intake_receipt": {
          "const": "schemas/source_intake_receipt.schema.json"
        },
        "vocal_stem_manifest": {
          "const": "schemas/vocal_stem_manifest.schema.json"
        }
      },
      "additionalProperties": false
    },
    "session_handoff": {
      "type": "object",
      "required": [
        "schema_version",
        "owner_skill",
        "lane",
        "schema",
        "validator",
        "template",
        "env_file",
        "env_load",
        "resume_requires_episode_id_and_explicit_request",
        "old_episode_access_without_resume",
        "secret_material"
      ],
      "properties": {
        "schema_version": {"const": "001short-session-handoff-v1"},
        "owner_skill": {"const": "001short-production-agent"},
        "lane": {"const": "general_shorts_production"},
        "schema": {"const": "schemas/conversation_handoff.schema.json"},
        "validator": {"const": "scripts/validate_conversation_handoff.py"},
        "template": {"const": "templates/conversation-handoff.json"},
        "env_file": {"const": "$HOME/.hermes/.env"},
        "env_load": {"const": "SOURCE_ONCE_WITHOUT_OUTPUT"},
        "resume_requires_episode_id_and_explicit_request": {"const": true},
        "old_episode_access_without_resume": {"const": "FORBIDDEN"},
        "secret_material": {"const": "FORBIDDEN"}
      },
      "additionalProperties": false
    },
    "production_modes": {
      "type": "object",
      "required": [
        "URAKKAI",
        "SOURCE_ORDER_UNCHANGED_CLEAN_ONLY",
        "SOURCE_ORDER_UNCHANGED_A10_RETAINED"
      ],
      "additionalProperties": false,
      "properties": {
        "URAKKAI": {
          "type": "object",
          "required": [
            "meaningful_reorder_required",
            "minimum_video_segments",
            "fake_split_forbidden",
            "approved_final_order_required",
            "allowed_audio_policies"
          ],
          "properties": {
            "meaningful_reorder_required": {
              "const": true
            },
            "minimum_video_segments": {
              "type": "integer",
              "minimum": 2
            },
            "fake_split_forbidden": {
              "const": true
            },
            "approved_final_order_required": {
              "const": true
            },
            "allowed_audio_policies": {
              "type": "array",
              "uniqueItems": true,
              "minItems": 3,
              "items": {
                "enum": ["A10_REASSEMBLED_SYNC", "TTS_ONLY_MUTE_SOURCE", "A9_TTS_PLUS_A10_REASSEMBLED", "CAPTION_ONLY_MUTE_SOURCE", "SOURCE_ORDER_CLEAN_AUDIO", "A9_TTS_PLUS_A10_SOURCE_CLIP"]
              }
            }
          },
          "additionalProperties": true
        },
        "SOURCE_ORDER_UNCHANGED_CLEAN_ONLY": {
          "type": "object",
          "required": [
            "explicit_exception_to_multi_cut_gate",
            "video_segments",
            "original_audio_segments",
            "video_duration",
            "original_audio_duration",
            "source_order_change"
          ],
          "properties": {
            "explicit_exception_to_multi_cut_gate": {
              "const": true
            },
            "video_segments": {
              "const": 1
            },
            "original_audio_segments": {
              "const": 1
            },
            "video_duration": {
              "const": "FULL_LENGTH"
            },
            "original_audio_duration": {
              "const": "FULL_LENGTH"
            },
            "source_order_change": {
              "const": "FORBIDDEN"
            }
          },
          "additionalProperties": true
        },
        "SOURCE_ORDER_UNCHANGED_A10_RETAINED": {
          "type": "object",
          "required": ["source_order_unchanged", "video_audio_mapping_must_match", "video_duration", "a10_duration", "allowed_audio_policies", "source_order_change"],
          "additionalProperties": true
        }
      }
    },
    "urakkai_approval": {
      "type": "object",
      "required": [
        "enabled_for",
        "approval_authority",
        "auto_mode_skips_user_approval",
        "required_report_artifacts",
        "manual_pass_state",
        "auto_pass_state"
      ],
      "properties": {
        "enabled_for": {
          "const": ["URAKKAI"]
        },
        "approval_authority": {
          "const": "user"
        },
        "auto_mode_skips_user_approval": {
          "const": true
        },
        "required_report_artifacts": {
          "const": [
            "20_script/original-capcut-grid.md",
            "20_script/urakkai-capcut-grid.md",
            "20_script/URAKKAI_BLUEPRINT.md"
          ]
        },
        "manual_pass_state": {
          "const": "WAIT_USER_URAKKAI_APPROVAL"
        },
        "auto_pass_state": {
          "const": "URAKKAI_AUTO_APPROVED"
        }
      },
      "additionalProperties": false
    },
    "invariants": {
      "type": "object",
      "required": [
        "single_active_lane",
        "session_handoff_secret_material_forbidden",
        "session_handoff_owner_must_remain_001",
        "old_episode_access_requires_explicit_resume",
        "state_advance_after_validator_pass_only",
        "vmake_api_first",
        "vmake_submit_after_source_identity",
        "vmake_candidate_integrity_only",
        "vmake_visual_quality_authority_user",
        "vmake_nonblocking_source_provisional_allowed",
        "source_provisional_video_asset_key",
        "source_provisional_report_required",
        "vmake_full_download_required",
        "vmake_direct_insert_required",
        "vmake_direct_insert_asset",
        "vmake_direct_insert_asset_key",
        "urakkai_final_duration_independent_from_source",
        "clean_visual_duration_matches_source_before_edit",
        "clean_only_full_source_duration_required",
        "capcut_root_immutable",
        "capcut_project_media_internal",
        "capcut_cloud_sync_explicit_request_required",
        "capcut_cloud_destination_explicit_request_required",
        "capcut_cloud_row_readback_required_when_requested",
        "capcut_cloud_reopen_playback_required_when_requested",
        "public_upload_requires_explicit_approval",
        "completion_report_requires_upload_metadata",
        "source_file_evidence_required",
        "vmake_final_download_evidence_required",
        "vmake_substitute_file_forbidden",
        "capcut_visual_confirmation_required_before_completion"
      ],
      "properties": {
        "session_handoff_secret_material_forbidden": {
          "const": true
        },
        "session_handoff_owner_must_remain_001": {
          "const": true
        },
        "old_episode_access_requires_explicit_resume": {
          "const": true
        },
        "vmake_full_download_required": {
          "const": true
        },
        "vmake_submit_after_source_identity": {
          "const": true
        },
        "vmake_candidate_integrity_only": {
          "const": true
        },
        "vmake_visual_quality_authority_user": {
          "const": true
        },
        "vmake_nonblocking_source_provisional_allowed": {
          "const": true
        },
        "source_provisional_video_asset_key": {
          "const": "source_video"
        },
        "source_provisional_report_required": {
          "const": true
        },
        "vmake_direct_insert_required": {
          "const": true
        },
        "vmake_direct_insert_asset": {
          "const": "40_assets_used/clean_source.mp4"
        },
        "vmake_direct_insert_asset_key": {
          "const": "clean_video"
        },
        "urakkai_final_duration_independent_from_source": {
          "const": true
        },
        "clean_visual_duration_matches_source_before_edit": {
          "const": true
        },
        "clean_only_full_source_duration_required": {
          "const": true
        },
        "capcut_cloud_sync_explicit_request_required": {
          "const": true
        },
        "capcut_cloud_destination_explicit_request_required": {
          "const": true
        },
        "capcut_cloud_row_readback_required_when_requested": {
          "const": true
        },
        "capcut_cloud_reopen_playback_required_when_requested": {
          "const": true
        }
      }
    },
    "manual_finalization": {
      "type": "object",
      "required": [
        "automation_terminal_state",
        "clean_source_policy",
        "user_only_actions",
        "source_video_provisional_next_action",
        "stage08_clean_swap_route"
      ],
      "properties": {
        "automation_terminal_state": {"const": "WAIT_USER_CAPCUT_CHECK"},
        "clean_source_policy": {
          "type": "object",
          "required": ["primary", "fallback", "user_override", "user_override_requires", "fallback_reasons", "sequence"],
          "properties": {
            "primary": {"const": "AGENT_PRIMARY_CLEAN_SOURCE"},
            "fallback": {"const": "USER_FALLBACK_CLEAN_SOURCE"},
            "user_override": {"const": "USER_APPROVED_NONMATCHING_CLEAN_SOURCE"},
            "user_override_requires": {"const": ["EXPLICIT_USER_APPROVAL", "FILE_SHA_BINDING"]},
            "fallback_reasons": {"const": ["VMAKE_CURRENT_WORK_WINDOW_INCOMPLETE", "VMAKE_ACQUISITION_ISSUE", "VMAKE_VERIFICATION_ISSUE"]},
            "sequence": {
              "const": [
                "VMAKE_SUBMIT_FIRST",
                "SOURCE_VIDEO_PROVISIONAL_BUILD_NONBLOCKING",
                "VALIDATE_CLEAN_SOURCE_THEN_VIDEO_ONLY_SWAP_OR_REASSEMBLY"
              ]
            }
          },
          "additionalProperties": false
        },
        "user_only_actions": {
          "const": [
            "capcut_visual_review_and_refinement",
            "render",
            "upload"
          ]
        },
        "source_video_provisional_next_action": {"const": "CLEAN_SOURCE_SWAP_NONBLOCKING"},
        "stage08_clean_swap_route": {"const": "scripts/build_episode_capcut.py --swap-provisional-video-only"}
      },
      "additionalProperties": false
    },
    "stages": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "01"
            }
          },
          "required": [
            "id",
            "name",
            "pass_state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "02"
            }
          },
          "required": [
            "id",
            "name",
            "pass_state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "03"
            }
          },
          "required": [
            "id",
            "name",
            "pass_state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "04"
            },
            "requires": {
              "const": ["20_script/original-capcut-grid.md"]
            },
            "produces": {
              "const": [
                "20_script/urakkai-capcut-grid.md",
                "20_script/URAKKAI_BLUEPRINT.md"
              ]
            }
          },
          "required": [
            "id",
            "name",
            "requires",
            "produces",
            "pass_state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "05"
            }
          },
          "required": [
            "id",
            "name",
            "pass_state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "06"
            }
          },
          "required": [
            "id",
            "name",
            "pass_state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "07"
            }
          },
          "required": [
            "id",
            "name",
            "pass_state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "08"
            }
          },
          "required": [
            "id",
            "name",
            "pass_state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "const": "09"
            }
          },
          "required": [
            "id",
            "name",
            "pass_state"
          ]
        }
      ],
      "items": false
    },
    "completion_report": {
      "type": "object",
      "required": [
        "required_fields",
        "source_required_fields",
        "cloud_sync_row_required_fields",
        "public_upload_done_values",
        "public_upload_approval_field"
      ],
      "properties": {
        "required_fields": {
          "type": "array",
          "contains": {
            "const": "upload_title"
          }
        },
        "source_required_fields": {
          "type": "array",
          "minItems": 2
        },
        "cloud_sync_row_required_fields": {
          "type": "array",
          "prefixItems": [
            {
              "const": "name"
            },
            {
              "const": "size"
            },
            {
              "const": "duration"
            },
            {
              "const": "type"
            },
            {
              "const": "modified_time"
            }
          ],
          "minItems": 5,
          "maxItems": 5,
          "items": false
        }
      }
    }
  },
  "additionalProperties": true
}
