{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taktwosj.example/schemas/001short-executable-production-plan-v2.json",
  "title": "001short Executable Production Plan",
  "type": "object",
  "required": [
    "schema_version",
    "episode_id",
    "root_profile",
    "project_name",
    "production_mode",
    "total_duration_us",
    "order_signature",
    "timeline",
    "audio_policy",
    "audio_source"
  ],
  "properties": {
    "schema_version": {"const": "001short-production-plan-v2"},
    "episode_id": {"type": "string", "minLength": 1},
    "root_profile": {"type": "string", "minLength": 1},
    "project_name": {"type": "string", "minLength": 1},
    "production_mode": {
      "enum": ["URAKKAI", "SOURCE_ORDER_UNCHANGED_CLEAN_ONLY", "SOURCE_ORDER_UNCHANGED_A10_RETAINED"]
    },
    "audio_policy": {
      "enum": ["SOURCE_ORDER_CLEAN_AUDIO", "A10_RETAINED_SYNC", "A10_REASSEMBLED_SYNC", "TTS_ONLY_MUTE_SOURCE", "A9_TTS_PLUS_A10_REASSEMBLED", "A9_TTS_PLUS_A10_SOURCE_CLIP", "CAPTION_ONLY_MUTE_SOURCE"]
    },
    "audio_source": {"enum": ["SOURCE_CLIP", "SOURCE_VOCAL_STEM", "REASSEMBLED_VOCAL_STEM", "GENERATED_TTS", "SILENCE"]},
    "assembly_type": {"type": "string", "minLength": 1},
    "execution_strategy": {"type": "string", "minLength": 1},
    "production_profile": {"type": "object"},
    "visual_asset_mode": {
      "enum": ["CLEAN_VISUAL_READY", "SOURCE_VIDEO_PROVISIONAL", "USER_APPROVED_NONMATCHING_CLEAN_SOURCE"]
    },
    "user_clean_override": {
      "type": "object",
      "required": ["status", "evidence"],
      "properties": {
        "status": {"const": "USER_APPROVED_NONMATCHING_CLEAN_SOURCE"},
        "evidence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "user_provided_media_overlay": {
      "type": "object",
      "required": ["schema_version", "episode_id", "status", "user_authority", "items"],
      "properties": {
        "schema_version": {"const": "001short-user-provided-media-overlay-v1"},
        "episode_id": {"type": "string", "minLength": 1},
        "status": {"const": "WAIT_USER_CAPCUT_AUDIO_ADJUSTMENT"},
        "user_authority": {
          "type": "object",
          "required": ["evidence", "exact_text"],
          "properties": {
            "evidence": {"type": "string", "minLength": 1},
            "exact_text": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        },
        "items": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["overlay_id", "media_kind", "track_index", "source_path", "source_sha256", "measured_duration_us", "dimensions", "target_range_us"],
            "properties": {
              "overlay_id": {"type": "string", "minLength": 1},
              "media_kind": {"enum": ["audio", "image", "video"]},
              "track_index": {"type": "integer", "minimum": 15},
              "source_path": {"type": "string", "minLength": 1},
              "source_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
              "measured_duration_us": {"type": "integer", "minimum": 0},
              "dimensions": {"type": "object"},
              "source_range_us": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}},
              "target_range_us": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "total_duration_us": {"type": "integer", "minimum": 1},
    "original_order": {"type": "array", "minItems": 1},
    "order_signature": {"type": "array", "minItems": 1},
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["segment_key", "target_range_us", "placements"],
        "properties": {
          "segment_key": {"type": "string", "minLength": 1},
          "target_range_us": {"$ref": "#/$defs/range"},
          "placements": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/placement"}
          }
        },
        "additionalProperties": true
      }
    },
    "cleared_anchors": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "locks": {"type": "object"}
  },
  "$defs": {
    "range": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 1}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "placement": {
      "type": "object",
      "required": ["anchor", "operation", "target_range_us"],
      "properties": {
        "anchor": {
          "enum": ["VIDEO", "T1", "T2", "A9", "A9_TEXT", "A10", "A10_TEXT", "STATE", "A11", "A12", "SCREEN"]
        },
        "operation": {
          "enum": ["clone_template_segment", "replace_template_text", "replace_text_preserve_style", "replace_media_and_range", "omit", "clear"]
        },
        "asset_key": {"type": "string", "minLength": 1},
        "text": {"type": "string"},
        "source_range_us": {"$ref": "#/$defs/range"},
        "target_range_us": {"$ref": "#/$defs/range"},
        "volume": {"type": "number", "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"anchor": {"enum": ["VIDEO", "A9", "A10"]}}},
          "then": {"required": ["asset_key", "source_range_us", "volume"]}
        },
        {
          "if": {"properties": {"anchor": {"enum": ["T1", "T2", "A9_TEXT", "A10_TEXT", "STATE"]}}},
          "then": {"required": ["text"]}
        }
      ],
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"production_mode": {"const": "SOURCE_ORDER_UNCHANGED_CLEAN_ONLY"}}
      },
      "then": {
        "required": ["cleared_anchors", "locks"],
        "properties": {
          "timeline": {"minItems": 1, "maxItems": 1},
          "locks": {
            "required": ["source_order_unchanged", "speed_unchanged", "original_audio_required"],
            "properties": {
              "source_order_unchanged": {"const": true},
              "speed_unchanged": {"const": true},
              "original_audio_required": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"production_mode": {"const": "URAKKAI"}}
      },
      "then": {
        "required": ["original_order"],
        "properties": {
          "timeline": {"minItems": 2}
        }
      }
    }
  ],
  "additionalProperties": true
}
