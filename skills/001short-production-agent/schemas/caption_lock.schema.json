{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "001short caption lock",
  "type": "object",
  "required": ["schema_version", "episode_id", "status", "audio_lock_path", "audio_lock_sha256", "final_srt_path", "final_srt_sha256", "final_cue_count", "cues", "all_cues_within_measured_audio", "no_overlap_verified"],
  "properties": {
    "schema_version": {"type": "string", "const": "001short-caption-lock-v1"},
    "episode_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "const": "PASS"},
    "audio_lock_path": {"type": "string", "minLength": 1},
    "audio_lock_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "final_srt_path": {"type": "string", "minLength": 1},
    "final_srt_sha256": {"type": "string", "pattern": "[0-9a-fA-F]{64}"},
    "final_cue_count": {"type": "integer"},
    "cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["cue_id", "start_us", "end_us", "text"],
        "properties": {
          "cue_id": {"type": "string", "minLength": 1},
          "start_us": {"type": "integer"},
          "end_us": {"type": "integer"},
          "text": {"type": "string", "minLength": 1},
          "layer": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "all_cues_within_measured_audio": {"type": "boolean", "const": true},
    "no_overlap_verified": {"type": "boolean", "const": true}
  },
  "additionalProperties": true
}
