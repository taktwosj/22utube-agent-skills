{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "001short approved production timeline",
  "type": "object",
  "required": ["schema_version", "episode_id", "source_fingerprint", "segments"],
  "properties": {
    "schema_version": {"type": "string", "const": "approved-timeline-v1"},
    "episode_id": {"type": "string", "minLength": 1},
    "source_fingerprint": {"type": "string", "minLength": 1},
    "production_mode": {"enum": ["URAKKAI", "SOURCE_ORDER_UNCHANGED_CLEAN_ONLY", "SOURCE_ORDER_UNCHANGED_A10_RETAINED"]},
    "audio_policy": {"enum": ["SOURCE_ORDER_CLEAN_AUDIO", "A10_RETAINED_SYNC", "A10_REASSEMBLED_SYNC", "TTS_ONLY_MUTE_SOURCE", "A9_TTS_PLUS_A10_RETAINED", "A9_TTS_PLUS_A10_REASSEMBLED", "A9_TTS_PLUS_A10_SOURCE_CLIP", "CAPTION_ONLY_MUTE_SOURCE"]},
    "primary_speaker_id": {"type": "string", "minLength": 1},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["segment_id", "timeline_order", "role", "start", "duration", "source_ref"],
        "properties": {
          "segment_id": {"type": "string", "minLength": 1},
          "timeline_order": {"type": "integer"},
          "role": {"type": "string", "minLength": 1},
          "start": {"type": "integer"},
          "duration": {"type": "integer"},
          "source_ref": {"type": "string", "minLength": 1},
          "text": {"type": "string"},
          "content_type": {"enum": ["TITLE", "TTS", "SPEAKER", "SITUATION", "STATE"]},
          "caption_role": {"enum": ["A9_TEXT", "A10_TEXT", "STATE"]},
          "cue_id": {"type": "string", "minLength": 1},
          "speaker_id": {"type": "string", "minLength": 1},
          "color_role": {"enum": ["WHITE", "YELLOW"]},
          "state_effect": {"enum": ["LASER_CUT", "GLITCH_SHAKE"]},
          "emphasis_range": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": {"type": "integer", "minimum": 0}
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
