{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "001short approved production timeline",
  "type": "object",
  "required": ["schema_version", "episode_id", "source_fingerprint", "segments"],
  "properties": {
    "schema_version": {"type": "string", "const": "approved-timeline-v1"},
    "episode_id": {"type": "string", "minLength": 1},
    "source_fingerprint": {"type": "string", "minLength": 1},
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["segment_id", "timeline_order", "role", "start", "duration", "source_ref"],
        "properties": {
          "segment_id": {"type": "string", "minLength": 1},
          "timeline_order": {"type": "integer"},
          "role": {"type": "string", "minLength": 1},
          "start": {"type": "integer"},
          "duration": {"type": "integer"},
          "source_ref": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "allOf": [
    {"properties": {"segments": {"contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "STATE"}}}}}},
    {"properties": {"segments": {"contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "A9"}}}}}},
    {"properties": {"segments": {"contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "A9_TEXT"}}}}}},
    {"properties": {"segments": {"contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "T1"}}}}}},
    {"properties": {"segments": {"contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "T2"}}}}}}
  ],
  "additionalProperties": true
}
