{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "001short approved production timeline",
  "type": "object",
  "required": ["schema_version", "episode_id", "source_fingerprint", "segments"],
  "properties": {
    "schema_version": {"enum": ["approved-timeline-v1", "approved-timeline-v2"]},
    "episode_id": {"type": "string", "minLength": 1},
    "source_fingerprint": {"type": "string", "minLength": 1},
    "project_name": {"type": "string", "minLength": 1},
    "production_mode": {"enum": ["URAKKAI", "SOURCE_ORDER_UNCHANGED_CLEAN_ONLY"]},
    "root_profile": {"type": "string", "minLength": 1},
    "total_duration_us": {"type": "integer", "minimum": 1},
    "primary_speaker_id": {"type": "string", "minLength": 1},
    "original_order": {"type": "array", "minItems": 1},
    "lane_policies": {
      "type": "object",
      "properties": {
        "VIDEO": {"$ref": "#/$defs/lane_policy"},
        "A9": {"$ref": "#/$defs/lane_policy"},
        "A10": {"$ref": "#/$defs/lane_policy"}
      },
      "additionalProperties": false
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["segment_id", "timeline_order", "role", "start", "duration", "source_ref"],
        "properties": {
          "segment_id": {"type": "string", "minLength": 1},
          "timeline_order": {"type": "integer"},
          "role": {"enum": ["VIDEO", "T1", "T2", "A9", "A9_TEXT", "A10", "A10_TEXT", "SPEAKER", "STATE", "A11", "A11_SFX", "A12", "SCREEN_EFFECT", "SCREEN_WHITE"]},
          "start": {"type": "integer", "minimum": 0},
          "duration": {"type": "integer", "minimum": 1},
          "source_ref": {"type": "string", "minLength": 1},
          "source_range_us": {"$ref": "#/$defs/range"},
          "asset_key": {"type": "string", "minLength": 1},
          "volume": {"type": "number", "minimum": 0},
          "text": {"type": "string"},
          "speaker_id": {"type": "string"},
          "state_effect": {"enum": ["FLICKER_RAVE", "GLITCH_SHAKE", "LASER_CUT"]},
          "sfx_kind": {"enum": ["TRANSITION", "REVERSAL", "WOW"]}
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "range": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 1}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "lane_policy": {
      "type": "object",
      "required": ["allow_gaps", "allow_overlaps"],
      "properties": {
        "allow_gaps": {"type": "boolean"},
        "allow_overlaps": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "approved-timeline-v1"}}},
      "then": {
        "allOf": [
          {"properties": {"segments": {"contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "STATE"}}}}}},
          {"properties": {"segments": {"contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "A9"}}}}}},
          {"properties": {"segments": {"contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "A9_TEXT"}}}}}},
          {"properties": {"segments": {"contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "T1"}}}}}},
          {"properties": {"segments": {"contains": {"type": "object", "required": ["role"], "properties": {"role": {"const": "T2"}}}}}}
        ]
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "approved-timeline-v2"}}},
      "then": {"required": ["project_name", "production_mode", "root_profile", "total_duration_us", "primary_speaker_id", "lane_policies"]}
    }
  ],
  "additionalProperties": true
}
