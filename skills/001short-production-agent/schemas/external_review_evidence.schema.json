{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "external_review_evidence.schema.json",
  "title": "Stage 04 external review evidence",
  "type": "object",
  "required": [
    "status",
    "episode_id",
    "input_sha256",
    "output_sha256",
    "selected_reviewer",
    "fallback_status",
    "approval_status",
    "findings",
    "applied_changes",
    "rejected_changes"
  ],
  "properties": {
    "status": {"const": "PASS"},
    "episode_id": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "output_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "selected_reviewer": {"enum": ["claude_cli", "codex_cli"]},
    "fallback_status": {"enum": ["NOT_USED", "CLAUDE_CALL_FAILED"]},
    "approval_status": {
      "enum": [
        "WAIT_USER_URAKKAI_APPROVAL",
        "USER_URAKKAI_APPROVED",
        "HERMES_DELEGATED_ROUTINE_APPROVAL_AFTER_EVIDENCE"
      ]
    },
    "findings": {"type": "array"},
    "applied_changes": {"type": "array"},
    "rejected_changes": {"type": "array"}
  },
  "allOf": [
    {
      "if": {"properties": {"selected_reviewer": {"const": "claude_cli"}}},
      "then": {"properties": {"fallback_status": {"const": "NOT_USED"}}}
    },
    {
      "if": {"properties": {"selected_reviewer": {"const": "codex_cli"}}},
      "then": {"properties": {"fallback_status": {"const": "CLAUDE_CALL_FAILED"}}}
    }
  ],
  "additionalProperties": true
}
