@@ -422,0 +425,35 @@ let warnedSymlinkFallback = false;
+function hasNonAsciiPathSegment(path: string): boolean {
+  return path.split(/[\\/]+/).some((segment) => /[^\x00-\x7f]/.test(segment));
+}
+
+function copyFrameDirWithoutCpSync(src: string, dest: string): void {
+  const source = lstatSync(src);
+  if (!source.isDirectory()) {
+    throw new Error(`Expected extracted frames source to be a directory: ${src}`);
+  }
+
+  mkdirSync(dest, { recursive: true });
+  for (const entry of readdirSync(src, { withFileTypes: true })) {
+    const sourcePath = join(src, entry.name);
+    const destinationPath = join(dest, entry.name);
+    if (entry.isDirectory()) {
+      copyFrameDirWithoutCpSync(sourcePath, destinationPath);
+    } else if (entry.isFile()) {
+      copyFileSync(sourcePath, destinationPath);
+    } else {
+      throw new Error(`Cannot materialize non-file extracted frame entry: ${sourcePath}`);
+    }
+  }
+}
+
+function copyFrameDir(fileSystem: MaterializeFileSystem, src: string, dest: string): void {
+  if (
+    process.platform === "win32" &&
+    (hasNonAsciiPathSegment(src) || hasNonAsciiPathSegment(dest))
+  ) {
+    copyFrameDirWithoutCpSync(src, dest);
+    return;
+  }
+  fileSystem.cpSync(src, dest, { recursive: true });
+}
+
